<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors />

    <NoWarn>$(NoWarn)</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>0</WarningLevel>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

  </PropertyGroup>

  <!-- Debug 모드: 파싱 로그만 활성화 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE;</DefineConstants>
  </PropertyGroup>

  <!-- Release 모드: 디버그 로그 비활성화 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- 개별 디버그 카테고리 활성화 예시 (필요시 주석 해제):
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE;DEBUG_PARSE_LOG;DEBUG_AST_LOG</DefineConstants>
  </PropertyGroup>

  디버그 로그 카테고리:
  - DEBUG_TOKEN_LOG: 토크나이저 로그 (토큰 생성 과정)
  - DEBUG_PARSE_LOG: 파서 로그 (규칙 매칭, 메모이제이션)
  - DEBUG_AST_LOG: AST 변환 로그 (Generated AST → SharpPy AST)
  - DEBUG_COMPILER_LOG: 컴파일러 로그 (바이트코드 생성)
  - DEBUG_VM_LOG: VM 로그 (바이트코드 실행)
  -->

  <!-- Exclude build tools Program.cs and obj folders to avoid duplicate attributes -->
  <ItemGroup>
    <Compile Remove="SharpPy.Tokenizer\**" />
    <Compile Remove="SharpPy.PegGenerator\**" />
  </ItemGroup>

  <!-- Tokenizer and PegGenerator are build-time tools only, not runtime dependencies -->
  <!-- They generate PyTokenizer.cs and PyParser.cs which are directly included in the build -->

  <!-- Tokenizer Generation (Phase 1) -->
  <Target Name="GenerateTokenizer" BeforeTargets="GenerateParser">
    <Message Text="Generating tokenizer from Grammar/Tokens..." Importance="high" />
    <Exec Command="dotnet run --project SharpPy.Tokenizer --tokens Grammar/Tokens --output Generated/PyTokenizer.cs"
          ContinueOnError="false"
          WorkingDirectory="$(ProjectDir)" />
  </Target>

  <!-- ASDL + PEG Parser Generation (Phase 2) -->
  <Target Name="GenerateParser" BeforeTargets="BeforeBuild">
    <Message Text="Generating AST types and PEG parser from ASDL + Grammar..." Importance="high" />
    <Exec Command="dotnet run --project SharpPy.PegGenerator --asdl Grammar/Python.asdl --grammar Grammar/python_cs.gram --tokens Grammar/Tokens --ast-output Generated/AstTypes.cs --parser-base-output Generated/PyParserBase.cs --parser-output Generated/PyParser.cs"
          ContinueOnError="false"
          WorkingDirectory="$(ProjectDir)" />
  </Target>

  <Target Name="CreateGeneratedDir" BeforeTargets="GenerateTokenizer">
    <MakeDir Directories="Generated" Condition="!Exists('Generated')" />
  </Target>

</Project>
