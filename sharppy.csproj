<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors />

    <NoWarn>$(NoWarn)</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>0</WarningLevel>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE;DEBUG_LOG;DEBUG_LOG_PARSER</DefineConstants>
    <!-- <DefineConstants>DEBUG;TRACE;DEBUG_LOG_PARSER</DefineConstants> -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Exclude PegGenerator files from main build but reference the library -->
  <ItemGroup>
    <Compile Remove="SharpPy.PegGenerator\**" />
    <EmbeddedResource Remove="SharpPy.PegGenerator\**" />
    <None Remove="SharpPy.PegGenerator\**" />
    <!-- Generated parser now included for Phase 1 testing -->
  </ItemGroup>

  <!-- Add reference to PegGenerator library -->
  <ItemGroup>
    <ProjectReference Include="SharpPy.PegGenerator\SharpPy.PegGenerator.csproj" />
  </ItemGroup>

  <!-- PEG Parser Generation -->
  <Target Name="GenerateParser" BeforeTargets="BeforeBuild">
    <Message Text="Generating PEG parser from Grammar/python.gram..." Importance="high" />
    <Exec Command="dotnet run --project SharpPy.PegGenerator --grammar Grammar/python.gram --tokens Grammar/Tokens --parser-output Generated/PyParser.cs --tokenizer-output Generated/PyTokenizer.cs"
          ContinueOnError="false"
          WorkingDirectory="$(ProjectDir)" />
  </Target>

  <Target Name="CreateGeneratedDir" BeforeTargets="GenerateParser">
    <MakeDir Directories="Generated" Condition="!Exists('Generated')" />
  </Target>

</Project>
