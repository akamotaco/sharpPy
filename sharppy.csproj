<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors />

    <NoWarn>$(NoWarn)</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>0</WarningLevel>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE;DEBUG_LOG;DEBUG_LOG_PARSER</DefineConstants>
    <!-- <DefineConstants>DEBUG;TRACE;DEBUG_LOG_PARSER</DefineConstants> -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Tokenizer and PegGenerator are build-time tools only, not runtime dependencies -->
  <!-- They generate PyTokenizer.cs and PyParser.cs which are directly included in the build -->

  <!-- Tokenizer Generation (Phase 1) -->
  <Target Name="GenerateTokenizer" BeforeTargets="GenerateParser">
    <Message Text="Generating tokenizer from Grammar/Tokens..." Importance="high" />
    <Exec Command="dotnet run --project SharpPy.Tokenizer --tokens Grammar/Tokens --output Generated/PyTokenizer.cs"
          ContinueOnError="false"
          WorkingDirectory="$(ProjectDir)" />
  </Target>

  <!-- PEG Parser Generation (Phase 2) -->
  <Target Name="GenerateParser" BeforeTargets="BeforeBuild">
    <Message Text="Generating PEG parser from Grammar/python.gram..." Importance="high" />
    <Exec Command="dotnet run --project ../SharpPy.PegGenerator --grammar Grammar/python.gram --tokens Grammar/Tokens --parser-output Generated/PyParser.cs"
          ContinueOnError="false"
          WorkingDirectory="$(ProjectDir)" />
  </Target>

  <Target Name="CreateGeneratedDir" BeforeTargets="GenerateTokenizer">
    <MakeDir Directories="Generated" Condition="!Exists('Generated')" />
  </Target>

</Project>
