# PEG grammar for Python
# 괄호로 묶어야 PyParser.cs 파일 생성시 인식함 : (생성할 내용물)

@trailer '''
// CPython 3.12: Entry point for file parsing
public GeneratedMod ParseFile()
{
    var result = Parse_File();
    if (result == null || _pendingSyntaxError != null)
    {
        var errorMsg = _pendingSyntaxError ?? "invalid syntax";

        // CPython 3.12: Get error location from known error token or current position
        // _knownErrToken is set by RaiseSyntaxError, but for parse failures we use _position
        GeneratedTokenInfo errorToken = _knownErrToken;

        // If no known error token, use the token at current parse position
        if (errorToken == null && _position < _tokens.Count)
        {
            errorToken = _tokens[_position];
        }
        // Fallback: use first token if no error token found
        else if (errorToken == null && _tokens.Count > 0)
        {
            errorToken = _tokens[0];
        }

        // CPython 3.12: If we're at a valid position, the error token should be here
        if (errorToken != null)
        {
            var ex = new PySyntaxErrorException(errorMsg, _filename,
                errorToken.Line, errorToken.Column,
                errorToken.EndColumn,
                GetSourceLine(errorToken.Line));
            throw ex;
        }

        throw new PySyntaxErrorException(errorMsg);
    }
    return result;
}

// CPython 3.12: Entry point for interactive parsing
public GeneratedMod ParseInteractive()
{
    var result = Parse_Interactive();
    if (result == null || _pendingSyntaxError != null)
    {
        var errorMsg = _pendingSyntaxError ?? "invalid syntax";

        GeneratedTokenInfo errorToken = _knownErrToken;
        if (errorToken == null && _position < _tokens.Count)
        {
            errorToken = _tokens[_position];
        }
        else if (errorToken == null && _tokens.Count > 0)
        {
            errorToken = _tokens[0];
        }

        if (errorToken != null)
        {
            var ex = new PySyntaxErrorException(errorMsg, _filename,
                errorToken.Line, errorToken.Column,
                errorToken.EndColumn,
                GetSourceLine(errorToken.Line));
            throw ex;
        }

        throw new PySyntaxErrorException(errorMsg);
    }
    return result;
}

// CPython 3.12: Entry point for eval parsing
public GeneratedMod ParseEval()
{
    var result = Parse_Eval();
    if (result == null || _pendingSyntaxError != null)
    {
        var errorMsg = _pendingSyntaxError ?? "invalid syntax";

        GeneratedTokenInfo errorToken = _knownErrToken;
        if (errorToken == null && _position < _tokens.Count)
        {
            errorToken = _tokens[_position];
        }
        else if (errorToken == null && _tokens.Count > 0)
        {
            errorToken = _tokens[0];
        }

        if (errorToken != null)
        {
            var ex = new PySyntaxErrorException(errorMsg, _filename,
                errorToken.Line, errorToken.Column,
                errorToken.EndColumn,
                GetSourceLine(errorToken.Line));
            throw ex;
        }

        throw new PySyntaxErrorException(errorMsg);
    }
    return result;
}

// CPython 3.12: Entry point for function type parsing
public GeneratedMod ParseFuncType()
{
    var result = Parse_FuncType();
    if (result == null || _pendingSyntaxError != null)
    {
        var errorMsg = _pendingSyntaxError ?? "invalid syntax";

        GeneratedTokenInfo errorToken = _knownErrToken;
        if (errorToken == null && _position < _tokens.Count)
        {
            errorToken = _tokens[_position];
        }
        else if (errorToken == null && _tokens.Count > 0)
        {
            errorToken = _tokens[0];
        }

        if (errorToken != null)
        {
            var ex = new PySyntaxErrorException(errorMsg, _filename,
                errorToken.Line, errorToken.Column,
                errorToken.EndColumn,
                GetSourceLine(errorToken.Line));
            throw ex;
        }

        throw new PySyntaxErrorException(errorMsg);
    }
    return result;
}
'''

# ========================= START OF THE GRAMMAR =========================

# General grammatical elements and rules:
#
# * Strings with double quotes (") denote SOFT KEYWORDS
# * Strings with single quotes (') denote KEYWORDS
# * Upper case names (NAME) denote tokens in the Grammar/Tokens file
# * Rule names starting with "invalid_" are used for specialized syntax errors
#     - These rules are NOT used in the first pass of the parser.
#     - Only if the first pass fails to parse, a second pass including the invalid
#       rules will be executed.
#     - If the parser fails in the second phase with a generic syntax error, the
#       location of the generic failure of the first pass will be used (this avoids
#       reporting incorrect locations due to the invalid rules).
#     - The order of the alternatives involving invalid rules matter
#       (like any rule in PEG).
#
# Grammar Syntax (see PEP 617 for more information):
#
# rule_name: expression
#   Optionally, a type can be included right after the rule name, which
#   specifies the return type of the C or Python function corresponding to the
#   rule:
# rule_name[return_type]: expression
#   If the return type is omitted, then a GeneratedPtr? is returned in C and an Any in
#   Python.
# e1 e2
#   Match e1, then match e2.
# e1 | e2
#   Match e1 or e2.
#   The first alternative can also appear on the line after the rule name for
#   formatting purposes. In that case, a | must be used before the first
#   alternative, like so:
#       rule_name[return_type]:
#            | first_alt
#            | second_alt
# ( e )
#   Match e (allows also to use other operators in the group like '(e)*')
# [ e ] or e?
#   Optionally match e.
# e*
#   Match zero or more occurrences of e.
# e+
#   Match one or more occurrences of e.
# s.e+
#   Match one or more occurrences of e, separated by s. The generated parse tree
#   does not include the separator. This is otherwise identical to (e (s e)*).
# &e
#   Succeed if e can be parsed, without consuming any input.
# !e
#   Fail if e can be parsed, without consuming any input.
# ~
#   Commit to the current alternative, even if it fails to parse.
#

# STARTING RULES
# ==============
# CPython 3.12 Grammar: Parser/python.gram (lines 75-85)
#
# C → C# 타입 변환:
# - [mod_ty] → [GeneratedMod] (module type)
# - [asdl_stmt_seq*] → [GeneratedStmtSeq] (statement sequence)
# - [asdl_expr_seq*] → [GeneratedExprSeq] (expression sequence)
# - [expr_ty] → [GeneratedExpr] (single expression)

# CPython: file[mod_ty]: a=[statements] ENDMARKER { MakeModule(p, a) }
file[GeneratedMod]: a=[statements] ENDMARKER { (GeneratedMod)PyParserHelpers.MakeModule((GeneratedStmtSeq?)a) }

# CPython: interactive[mod_ty]: a=statement_newline { _PyAST_Interactive(a, p->arena) }
interactive[GeneratedMod]: a=statement_newline { (GeneratedMod)PyAst.Interactive((GeneratedStmtSeq)a) }

# CPython: eval[mod_ty]: a=expressions NEWLINE* ENDMARKER { _PyAST_Expression(a, p->arena) }
eval[GeneratedMod]: a=expressions NEWLINE* ENDMARKER { (GeneratedMod)PyAst.Expression((GeneratedExpr)a) }

# CPython: func_type[mod_ty]: '(' a=[type_expressions] ')' '->' b=expression NEWLINE* ENDMARKER { _PyAST_FunctionType(a, b, p->arena) }
func_type[GeneratedMod]: '(' a=[type_expressions] ')' '->' b=expression NEWLINE* ENDMARKER { (GeneratedMod)PyAst.FunctionType((GeneratedExprSeq?)a, (GeneratedExpr)b) }

# GENERAL STATEMENTS
# ==================
# CPython 3.12 Grammar: Parser/python.gram (lines 87-120)
#
# C → C# 타입 변환:
# - [asdl_stmt_seq*] → [GeneratedStmtSeq] (statement sequence)
# - [stmt_ty] → [GeneratedStmt] (single statement)
# - _PyPegen_* → PyParserHelpers.* (C# static methods)
# - _PyAST_* → PyAst.* (C# static methods)
# - CHECK<stmt_ty> → Check<GeneratedStmt>

# CPython: statements[asdl_stmt_seq*]: a=statement+ { (asdl_stmt_seq*)SeqFlatten(p, a) }
# C#: GeneratedSeq → GeneratedStmtSeq (flatten nested sequences)
statements[GeneratedStmtSeq]: a=statement+ { PyParserHelpers.FlattenStatementSequence(a).Cast<GeneratedStmtSeq>() }

# CPython: statement[asdl_stmt_seq*]: a=compound_stmt { (asdl_stmt_seq*)SingletonSeq(p, a) } | a[asdl_stmt_seq*]=simple_stmts { a }
# C#: compound_stmt는 singleton sequence로 변환, simple_stmts는 이미 sequence
statement[GeneratedStmtSeq]:
    | a=compound_stmt { PyParserHelpers.SingletonSequence((GeneratedStmt)a).Cast<GeneratedStmtSeq>() }
    | a=simple_stmts { a }

# CPython: statement_newline[asdl_stmt_seq*]: ...
# C#: Interactive mode용 - NEWLINE만 있으면 Pass statement, ENDMARKER는 종료
statement_newline[GeneratedStmtSeq]:
    | a=compound_stmt NEWLINE { PyParserHelpers.SingletonSequence((GeneratedStmt)a).Cast<GeneratedStmtSeq>() }
    | simple_stmts
    | NEWLINE { PyParserHelpers.SingletonSequence(Check<GeneratedStmt>(PyAst.Pass(EXTRA))).Cast<GeneratedStmtSeq>() }
    | ENDMARKER { PyParserHelpers.InteractiveExit() }

# CPython: simple_stmts[asdl_stmt_seq*]: ...
# C#: 단일 simple_stmt 또는 ';'로 구분된 여러 simple_stmt를 sequence로 반환
simple_stmts[GeneratedStmtSeq]:
    | a=simple_stmt !';' NEWLINE { PyParserHelpers.SingletonSequence((GeneratedStmt)a).Cast<GeneratedStmtSeq>() } # Not needed, there for speedup
    | a=';'.simple_stmt+ [';'] NEWLINE { (GeneratedStmtSeq)a }

# NOTE: assignment MUST precede expression, else parsing a simple assignment
# will throw a SyntaxError.
# CPython: simple_stmt[stmt_ty] (memo): ...
# C#: 단일 statement 반환 (Pass, Break, Continue, Expr 등)
simple_stmt[GeneratedStmt] (memo):
    | assignment
    | &"type" type_alias
    | e=star_expressions { PyAst.Expr((GeneratedExpr)e, EXTRA) }
    | &'return' return_stmt
    | &('import' | 'from') import_stmt
    | &'raise' raise_stmt
    | 'pass' { PyAst.Pass(EXTRA) }
    | &'del' del_stmt
    | &'yield' yield_stmt
    | &'assert' assert_stmt
    | 'break' { PyAst.Break(EXTRA) }
    | 'continue' { PyAst.Continue(EXTRA) }
    | &'global' global_stmt
    | &'nonlocal' nonlocal_stmt

# CPython: compound_stmt[stmt_ty]: ...
# C#: function_def, if_stmt, class_def 등 compound statement 반환
compound_stmt[GeneratedStmt]:
    | &('def' | '@' | ASYNC) a=function_def { a }
    | &'if' a=if_stmt { a }
    | &('class' | '@') a=class_def { a }
    | &('with' | ASYNC) a=with_stmt { a }
    | &('for' | ASYNC) a=for_stmt { a }
    | &'try' a=try_stmt { a }
    | &'while' a=while_stmt { a }
    | a=match_stmt { a }

# SIMPLE STATEMENTS
# =================
# CPython 3.12 Grammar: Parser/python.gram (lines 122-191)
#
# C → C# 타입 변환:
# - [stmt_ty] → [GeneratedStmt] (single statement)
# - [expr_ty] → [GeneratedExpr] (single expression)
# - [asdl_expr_seq*] → [GeneratedExprSeq] (expression sequence)
# - [asdl_alias_seq*] → [GeneratedAliasSeq] (import alias sequence)
# - [alias_ty] → [GeneratedAlias] (single import alias)
# - [AugOperator*] → [GeneratedOperator] (augmented assignment operator)
# - CHECK_VERSION(stmt_ty, ...) → CheckVersion(...) (returns GeneratedStmt)
# - _PyAST_* → PyAst.* (C# static methods)
# - _PyPegen_* → PyParserHelpers.* (C# static methods)

# NOTE: annotated_rhs may start with 'yield'; yield_expr must start with 'yield'
# CPython: assignment[stmt_ty]: ...
# C#: 4가지 assignment 형태 - AnnAssign (annotated), Assign (normal), AugAssign (augmented)
assignment[GeneratedStmt]:
    | a=NAME ':' b=expression c=['=' d=annotated_rhs { d }] {
        CheckVersion(
            6,
            "Variable annotation syntax is",
            PyAst.AnnAssign(Check<GeneratedExpr>(PyParserHelpers.SetExprContext(NameToken(a), Store)), (GeneratedExpr)b, (GeneratedExpr?)c, 1, EXTRA)
        ) }
    | a=('(' b=single_target ')' { b }
         | single_subscript_attribute_target) ':' b=expression c=['=' d=annotated_rhs { d }] {
        CheckVersion(6, "Variable annotations syntax is", PyAst.AnnAssign((GeneratedExpr)a, (GeneratedExpr)b, (GeneratedExpr?)c, 0, EXTRA)) }
    | a[GeneratedExprSeq]=(z=star_targets '=' { z })+ b=(yield_expr | star_expressions) !'=' tc=[TYPE_COMMENT] {
         PyAst.Assign((GeneratedExprSeq)a, (GeneratedExpr)b, tc.GetCommentValue(), EXTRA) }
    | a=single_target b=augassign ~ c=(yield_expr | star_expressions) {
         PyAst.AugAssign((GeneratedExpr)a, (GeneratedOperator)b, (GeneratedExpr)c, EXTRA) }
    | invalid_assignment

# CPython: annotated_rhs[expr_ty]: yield_expr | star_expressions
# C#: RHS of annotated assignment can be yield expression or star expressions
annotated_rhs[GeneratedExpr]: a=yield_expr { a } | a=star_expressions { a }

# CPython: augassign[AugOperator*]: ...
# C#: Augmented assignment operators (+=, -=, *=, etc.)
augassign[GeneratedOperator]:
    | '+=' { PyParserHelpers.AugOperator(Add) }
    | '-=' { PyParserHelpers.AugOperator(Sub) }
    | '*=' { PyParserHelpers.AugOperator(Mult) }
    | '@=' { CheckVersion(5, "The '@' operator is", PyParserHelpers.AugOperator(MatMult)) }
    | '/=' { PyParserHelpers.AugOperator(Div) }
    | '%=' { PyParserHelpers.AugOperator(Mod) }
    | '&=' { PyParserHelpers.AugOperator(BitAnd) }
    | '|=' { PyParserHelpers.AugOperator(BitOr) }
    | '^=' { PyParserHelpers.AugOperator(BitXor) }
    | '<<=' { PyParserHelpers.AugOperator(LShift) }
    | '>>=' { PyParserHelpers.AugOperator(RShift) }
    | '**=' { PyParserHelpers.AugOperator(Pow) }
    | '//=' { PyParserHelpers.AugOperator(FloorDiv) }

# CPython: return_stmt[stmt_ty]: 'return' a=[star_expressions] { _PyAST_Return(a, EXTRA) }
# C#: return statement with optional expressions
return_stmt[GeneratedStmt]:
    | 'return' a=[star_expressions] { PyAst.Return((GeneratedExpr?)a, EXTRA) }

# CPython: raise_stmt[stmt_ty]: ...
# C#: raise statement with optional exception and 'from' clause
raise_stmt[GeneratedStmt]:
    | 'raise' a=expression b=['from' z=expression { z }] { PyAst.Raise((GeneratedExpr)a, (GeneratedExpr?)b, EXTRA) }
    | 'raise' { PyAst.Raise(null, null, EXTRA) }

# CPython: global_stmt[stmt_ty]: 'global' a[asdl_expr_seq*]=','.NAME+ { _PyAST_Global(CHECK<asdl_identifier_seq>(MapNamesToIds(a)), EXTRA) }
# C#: global statement - converts NAME sequence to identifier sequence
global_stmt[GeneratedStmt]: 'global' a[GeneratedExprSeq]=','.NAME+ {
    PyAst.Global(Check<GeneratedIdentifierSeq>(PyParserHelpers.MapNamesToIds((GeneratedExprSeq)a)), EXTRA) }

# CPython: nonlocal_stmt[stmt_ty]: 'nonlocal' a[asdl_expr_seq*]=','.NAME+ { _PyAST_Nonlocal(CHECK<asdl_identifier_seq>(MapNamesToIds(a)), EXTRA) }
# C#: nonlocal statement - converts NAME sequence to identifier sequence
nonlocal_stmt[GeneratedStmt]: 'nonlocal' a[GeneratedExprSeq]=','.NAME+ {
    PyAst.Nonlocal(Check<GeneratedIdentifierSeq>(PyParserHelpers.MapNamesToIds((GeneratedExprSeq)a)), EXTRA) }

# CPython: del_stmt[stmt_ty]: 'del' a=del_targets &(';' | NEWLINE) { _PyAST_Delete(a, EXTRA) } | invalid_del_stmt
# C#: del statement - deletes targets
del_stmt[GeneratedStmt]:
    | 'del' a=del_targets &(';' | NEWLINE) { PyAst.Delete((GeneratedExprSeq)a, EXTRA) }
    | invalid_del_stmt

# CPython: yield_stmt[stmt_ty]: y=yield_expr { _PyAST_Expr(y, EXTRA) }
# C#: yield as statement (wrapped in Expr)
yield_stmt[GeneratedStmt]: y=yield_expr { PyAst.Expr((GeneratedExpr)y, EXTRA) }

# CPython: assert_stmt[stmt_ty]: 'assert' a=expression b=[',' z=expression { z }] { _PyAST_Assert(a, b, EXTRA) }
# C#: assert statement with optional message
assert_stmt[GeneratedStmt]: 'assert' a=expression b=[',' z=expression { z }] { PyAst.Assert((GeneratedExpr)a, (GeneratedExpr?)b, EXTRA) }

# CPython: import_stmt[stmt_ty]: invalid_import | import_name | import_from
# C#: import statement - either 'import' or 'from...import'
import_stmt[GeneratedStmt]:
    | invalid_import
    | import_name
    | import_from

# Import statements
# -----------------

# CPython: import_name[stmt_ty]: 'import' a=dotted_as_names { _PyAST_Import(a, EXTRA) }
# C#: 'import x, y as z' - regular import statement
import_name[GeneratedStmt]: 'import' a=dotted_as_names { PyAst.Import((GeneratedAliasSeq)a, EXTRA) }

# note below: the ('.' | '...') is necessary because '...' is tokenized as ELLIPSIS
# CPython: import_from[stmt_ty]: ...
# C#: 'from x import y' - relative or absolute import with optional dots
import_from[GeneratedStmt]:
    | 'from' a=('.' | '...')* b=dotted_name 'import' c=import_from_targets {
        PyParserHelpers.CheckedFutureImport(b.GetIdentifier(), (GeneratedAliasSeq)c, PyParserHelpers.SeqCountDots(a.ToRawList()), EXTRA) }
    | 'from' a=('.' | '...')+ 'import' b=import_from_targets {
        PyAst.ImportFrom(null, (GeneratedAliasSeq)b, PyParserHelpers.SeqCountDots(a.ToRawList()), EXTRA) }

# CPython: import_from_targets[asdl_alias_seq*]: ...
# C#: Targets for 'from...import' - can be (a, b), a, or *
import_from_targets[GeneratedAliasSeq]:
    | '(' a=import_from_as_names [','] ')' { a }
    | import_from_as_names !','
    | '*' { PyParserHelpers.SingletonSequence(Check<GeneratedAlias>(PyParserHelpers.AliasForStar(EXTRA))).Cast<GeneratedAliasSeq>() }
    | invalid_import_from_targets

# CPython: import_from_as_names[asdl_alias_seq*]: a[asdl_alias_seq*]=','.import_from_as_name+ { a }
# C#: Comma-separated import aliases 'x as y, z as w'
import_from_as_names[GeneratedAliasSeq]:
    | a[GeneratedAliasSeq]=','.import_from_as_name+ { a }

# CPython: import_from_as_name[alias_ty]: a=NAME b=['as' z=NAME { z }] { _PyAST_alias(a.GetNameValue(), b?.Value, EXTRA) }
# C#: Single import alias 'x as y' or just 'x'
import_from_as_name[GeneratedAlias]:
    | a=NAME b=['as' z=NAME { z }] { PyAst.alias(a.GetNameValue(),
                                               b.GetNameValue(),
                                               EXTRA) }

# CPython: dotted_as_names[asdl_alias_seq*]: a[asdl_alias_seq*]=','.dotted_as_name+ { a }
# C#: Comma-separated dotted names 'x.y as z, a.b as c'
dotted_as_names[GeneratedAliasSeq]:
    | a[GeneratedAliasSeq]=','.dotted_as_name+ { a }

# CPython: dotted_as_name[alias_ty]: a=dotted_name b=['as' z=NAME { z }] { _PyAST_alias(a.GetIdentifier(), b?.Value, EXTRA) }
# C#: Single dotted name 'x.y.z as w' or just 'x.y.z'
dotted_as_name[GeneratedAlias]:
    | a=dotted_name b=['as' z=NAME { z }] { PyAst.alias(a.GetIdentifier(),
                                                      b.GetNameValue(),
                                                      EXTRA) }

# CPython: dotted_name[expr_ty]: a=dotted_name '.' b=NAME { JoinNamesWithDot(a, b) } | NAME
# C#: Dotted name like 'x.y.z' - recursively joined names
dotted_name[GeneratedExpr]:
    | a=dotted_name '.' b=NAME { PyParserHelpers.JoinNamesWithDot(a, NameToken(b)) }
    | NAME

# COMPOUND STATEMENTS
# ===================
# CPython 3.12 Grammar: Parser/python.gram (lines 193-289)
#
# C → C# 타입 변환:
# - [stmt_ty] → [GeneratedStmt] (single statement)
# - [asdl_stmt_seq*] → [GeneratedStmtSeq] (statement sequence)
# - [asdl_expr_seq*] → [GeneratedExprSeq] (expression sequence)
# - [asdl_arg_seq*] → [GeneratedArgSeq] (argument sequence)
# - [arg_ty] → [GeneratedArg] (single argument)
# - [arguments_ty] → [GeneratedArguments] (function parameters)
# - [expr_ty] → [GeneratedExpr] (expression)
# - [SlashWithDefault*] → [GeneratedSlashWithDefault] (positional-only params with defaults)
# - [StarEtc*] → [GeneratedStarEtc] (*args and **kwargs)
# - [NameDefaultPair*] → [GeneratedNameDefaultPair] (parameter with default value)

# Common elements
# ---------------

# CPython: block[asdl_stmt_seq*] (memo): NEWLINE INDENT a=statements DEDENT { a } | simple_stmts | invalid_block
# C#: Block of statements (indented or single line)
block[GeneratedStmtSeq] (memo):
    | NEWLINE INDENT a=statements DEDENT { a }
    | simple_stmts
    | invalid_block

# CPython: decorators[asdl_expr_seq*]: a[asdl_expr_seq*]=('@' f=named_expression NEWLINE { f })+ { a }
# C#: Decorator list @decorator_name
decorators[GeneratedExprSeq]: a[GeneratedExprSeq]=('@' f=named_expression NEWLINE { f })+ { a }

# Class definitions
# -----------------

# CPython: class_def[stmt_ty]: a=decorators b=class_def_raw { ClassDefDecorators(a, b) } | class_def_raw
# C#: Class definition with optional decorators
class_def[GeneratedStmt]:
    | a=decorators b=class_def_raw { PyParserHelpers.ClassDefDecorators(a, b) }
    | class_def_raw

# CPython: class_def_raw[stmt_ty]: invalid_class_def_raw | 'class' a=NAME t=[type_params] b=['(' z=[arguments] ')' { z }] ':' c=block { _PyAST_ClassDef(...) }
# C#: Class definition body - name, bases, keywords, body, decorators, type_params
class_def_raw[GeneratedStmt]:
    | invalid_class_def_raw
    | 'class' a=NAME t=[type_params] b=['(' z=[arguments] ')' { z }] ':' c=block {
        PyAst.ClassDef(a.GetNameValue(),
                     (b != null) ? ((GeneratedCall)b).Args : null!,
                     (b != null) ? ((GeneratedCall)b).Keywords : null!,
                     c, null!, t, EXTRA) }

# Function definitions
# --------------------

# CPython: function_def[stmt_ty]: d=decorators f=function_def_raw { FunctionDefDecorators(d, f) } | function_def_raw
# C#: Function definition with optional decorators
function_def[GeneratedStmt]:
    | d=decorators f=function_def_raw { PyParserHelpers.FunctionDefDecorators(d, f) }
    | function_def_raw

# CPython: function_def_raw[stmt_ty]: ...
# C#: Function definition body - name, params, body, decorators, returns, type_comment, type_params
function_def_raw[GeneratedStmt]:
    | invalid_def_raw
    | 'def' n=NAME t=[type_params] &&'(' params_=[params] ')' a=['->' z=expression { z }] &&':' tc=[func_type_comment] b=block {
        PyAst.FunctionDef(n.GetNameValue(),
                        (params_ != null) ? params_ : (GeneratedArguments)Check<GeneratedArguments>(PyParserHelpers.EmptyArguments()),
                        b, null, (GeneratedExpr?)a, tc.GetCommentValue(), t, EXTRA) }
    | ASYNC 'def' n=NAME t=[type_params] &&'(' params_=[params] ')' a=['->' z=expression { z }] &&':' tc=[func_type_comment] b=block {
        CheckVersion(
            5,
            "Async functions are",
            PyAst.AsyncFunctionDef(n.GetNameValue(),
                            (params_ != null) ? params_ : (GeneratedArguments)Check<GeneratedArguments>(PyParserHelpers.EmptyArguments()),
                            b, null, (GeneratedExpr?)a, tc.GetCommentValue(), t, EXTRA)
        ) }

# Function parameters
# -------------------

# CPython: params[arguments_ty]: invalid_parameters | parameters
# C#: Function parameters wrapper
params[GeneratedArguments]:
    | a=invalid_parameters { (GeneratedArguments)a }
    | a=parameters { (GeneratedArguments)a }

# CPython: parameters[arguments_ty]: ...
# C#: Function parameter combinations (positional-only, regular, keyword-only, *args, **kwargs)
parameters[GeneratedArguments]:
    | a=slash_no_default b[GeneratedArgSeq]=param_no_default* c=param_with_default* d=[star_etc] {
        CheckVersion(8, "Positional-only parameters are", PyParserHelpers.MakeArguments((GeneratedArgSeq)a, null, b, c?.Cast<GeneratedNameDefaultPairSeq>(), (GeneratedStarEtc?)d)) }
    | a=slash_with_default b=param_with_default* c=[star_etc] {
        CheckVersion(8, "Positional-only parameters are", PyParserHelpers.MakeArguments(null, (GeneratedSlashWithDefault)a, null, b?.Cast<GeneratedNameDefaultPairSeq>(), (GeneratedStarEtc?)c)) }
    | a[GeneratedArgSeq]=param_no_default+ b=param_with_default* c=[star_etc] {
        PyParserHelpers.MakeArguments(null, null, a, b?.Cast<GeneratedNameDefaultPairSeq>(), (GeneratedStarEtc?)c) }
    | a=param_with_default+ b=[star_etc] { PyParserHelpers.MakeArguments(null, null, null, a?.Cast<GeneratedNameDefaultPairSeq>(), (GeneratedStarEtc?)b)}
    | a=star_etc { PyParserHelpers.MakeArguments(null, null, null, null, (GeneratedStarEtc)a) }

# Some duplication here because we can't write (',' | &')'),
# which is because we don't support empty alternatives (yet).

# CPython: slash_no_default[asdl_arg_seq*]: a[asdl_arg_seq*]=param_no_default+ '/' ',' { a } | ...
# C#: Positional-only parameters without defaults (PEP 570)
slash_no_default[GeneratedArgSeq]:
    | a[GeneratedArgSeq]=param_no_default+ '/' ',' { a }
    | a[GeneratedArgSeq]=param_no_default+ '/' &')' { a }

# CPython: slash_with_default[SlashWithDefault*]: a=param_no_default* b=param_with_default+ '/' ',' { _PyPegen_slash_with_default(a, b) } | ...
# C#: Positional-only parameters with defaults (PEP 570)
slash_with_default[GeneratedSlashWithDefault]:
    | a=param_no_default* b=param_with_default+ '/' ',' { PyParserHelpers.SlashWithDefault(a?.Cast<GeneratedArgSeq>(), b?.Cast<GeneratedNameDefaultPairSeq>()) }
    | a=param_no_default* b=param_with_default+ '/' &')' { PyParserHelpers.SlashWithDefault(a?.Cast<GeneratedArgSeq>(), b?.Cast<GeneratedNameDefaultPairSeq>()) }

# CPython: star_etc[StarEtc*]: ...
# C#: *args and **kwargs parameters
star_etc[GeneratedStarEtc]:
    | invalid_star_etc
    | '*' a=param_no_default b=param_maybe_default* c=[kwds] {
        PyParserHelpers.StarEtc((GeneratedArg)a, b?.Cast<GeneratedNameDefaultPairSeq>(), (GeneratedArg?)c) }
    | '*' a=param_no_default_star_annotation b=param_maybe_default* c=[kwds] {
        PyParserHelpers.StarEtc((GeneratedArg)a, b?.Cast<GeneratedNameDefaultPairSeq>(), (GeneratedArg?)c) }
    | '*' ',' b=param_maybe_default+ c=[kwds] {
        PyParserHelpers.StarEtc(null, b?.Cast<GeneratedNameDefaultPairSeq>(), (GeneratedArg?)c) }
    | a=kwds { PyParserHelpers.StarEtc(null, null, (GeneratedArg)a) }

# CPython: kwds[arg_ty]: invalid_kwds | '**' a=param_no_default { a }
# C#: **kwargs parameter
kwds[GeneratedArg]:
    | invalid_kwds
    | '**' a=param_no_default { a }

# One parameter.  This *includes* a following comma and type comment.
#
# There are three styles:
# - No default
# - With default
# - Maybe with default
#
# There are two alternative forms of each, to deal with type comments:
# - Ends in a comma followed by an optional type comment
# - No comma, optional type comment, must be followed by close paren
# The latter form is for a final parameter without trailing comma.
#

# CPython: param_no_default[arg_ty]: a=param ',' tc=TYPE_COMMENT? { _PyPegen_add_type_comment_to_arg(a, tc) } | ...
# C#: Parameter without default value
param_no_default[GeneratedArg]:
    | a=param ',' tc=TYPE_COMMENT? { PyParserHelpers.AddTypeCommentToArg(a, tc) }
    | a=param tc=TYPE_COMMENT? &')' { PyParserHelpers.AddTypeCommentToArg(a, tc) }

# CPython: param_no_default_star_annotation[arg_ty]: a=param_star_annotation ',' tc=TYPE_COMMENT? { _PyPegen_add_type_comment_to_arg(a, tc) } | ...
# C#: Parameter with star annotation (for *args)
param_no_default_star_annotation[GeneratedArg]:
    | a=param_star_annotation ',' tc=TYPE_COMMENT? { PyParserHelpers.AddTypeCommentToArg(a, tc) }
    | a=param_star_annotation tc=TYPE_COMMENT? &')' { PyParserHelpers.AddTypeCommentToArg(a, tc) }

# CPython: param_with_default[NameDefaultPair*]: a=param c=default ',' tc=TYPE_COMMENT? { _PyPegen_name_default_pair(a, c, tc) } | ...
# C#: Parameter with default value
param_with_default[GeneratedNameDefaultPair]:
    | a=param c=default ',' tc=TYPE_COMMENT? { PyParserHelpers.NameDefaultPair(a, c, tc?.Value) }
    | a=param c=default tc=TYPE_COMMENT? &')' { PyParserHelpers.NameDefaultPair(a, c, tc?.Value) }

# CPython: param_maybe_default[NameDefaultPair*]: a=param c=default? ',' tc=TYPE_COMMENT? { _PyPegen_name_default_pair(a, c, tc) } | ...
# C#: Parameter with optional default value
param_maybe_default[GeneratedNameDefaultPair]:
    | a=param c=default? ',' tc=TYPE_COMMENT? { PyParserHelpers.NameDefaultPair(a, c, tc?.Value) }
    | a=param c=default? tc=TYPE_COMMENT? &')' { PyParserHelpers.NameDefaultPair(a, c, tc?.Value) }

# CPython: param[arg_ty]: a=NAME b=annotation? { _PyAST_arg(a.GetNameValue(), b, null, EXTRA) }
# C#: Single parameter (name and optional type annotation)
param[GeneratedArg]: a=NAME b=annotation? { PyAst.arg(a.GetNameValue(), b, null, EXTRA) }

# CPython: param_star_annotation[arg_ty]: a=NAME b=star_annotation { _PyAST_arg(a.GetNameValue(), b, null, EXTRA) }
# C#: Parameter with star annotation (*expr instead of expr)
param_star_annotation[GeneratedArg]: a=NAME b=star_annotation { PyAst.arg(a.GetNameValue(), b, null, EXTRA) }

# CPython: annotation[expr_ty]: ':' a=expression { a }
# C#: Type annotation ': type'
annotation[GeneratedExpr]: ':' a=expression { a }

# CPython: star_annotation[expr_ty]: ':' a=star_expression { a }
# C#: Star annotation ': *type'
star_annotation[GeneratedExpr]: ':' a=star_expression { a }

# CPython: default[expr_ty]: '=' a=expression { a } | invalid_default
# C#: Default value '= expr'
default[GeneratedExpr]: '=' a=expression { a } | invalid_default

# If statement
# ------------

# CPython: if_stmt[stmt_ty]: ...
# C#: if/elif/else statement - elif chains are represented as nested If nodes
if_stmt[GeneratedStmt]:
    | invalid_if_stmt
    | 'if' a=named_expression ':' b=block c=elif_stmt {
        PyAst.If((GeneratedExpr)a, (GeneratedStmtSeq)b, Check<GeneratedStmtSeq>(PyParserHelpers.SingletonSequence((GeneratedStmt)c).Cast<GeneratedStmtSeq>()), EXTRA) }
    | 'if' a=named_expression ':' b=block c=[else_block] { PyAst.If((GeneratedExpr)a, (GeneratedStmtSeq)b, (GeneratedStmtSeq?)c, EXTRA) }

# CPython: elif_stmt[stmt_ty]: ...
# C#: elif is transformed to nested if statement
elif_stmt[GeneratedStmt]:
    | invalid_elif_stmt
    | 'elif' a=named_expression ':' b=block c=elif_stmt {
        PyAst.If((GeneratedExpr)a, (GeneratedStmtSeq)b, Check<GeneratedStmtSeq>(PyParserHelpers.SingletonSequence((GeneratedStmt)c).Cast<GeneratedStmtSeq>()), EXTRA) }
    | 'elif' a=named_expression ':' b=block c=[else_block] { PyAst.If((GeneratedExpr)a, (GeneratedStmtSeq)b, (GeneratedStmtSeq?)c, EXTRA) }

# CPython: else_block[asdl_stmt_seq*]: invalid_else_stmt | 'else' &&':' b=block { b }
# C#: else block returns statement sequence
else_block[GeneratedStmtSeq]:
    | invalid_else_stmt
    | 'else' &&':' b=block { b }

# While statement
# ---------------

# CPython: while_stmt[stmt_ty]: invalid_while_stmt | 'while' a=named_expression ':' b=block c=[else_block] { _PyAST_While(a, b, c, EXTRA) }
# C#: while statement with optional else clause (Python-specific)
while_stmt[GeneratedStmt]:
    | invalid_while_stmt
    | 'while' a=named_expression ':' b=block c=[else_block] { PyAst.While((GeneratedExpr)a, (GeneratedStmtSeq)b, (GeneratedStmtSeq?)c, EXTRA) }

# For statement
# -------------

# CPython: for_stmt[stmt_ty]: ...
# C#: for/async for statement with optional else clause
for_stmt[GeneratedStmt]:
    | invalid_for_stmt
    | 'for' t=star_targets 'in' ~ ex=star_expressions ':' tc=[TYPE_COMMENT] b=block el=[else_block] {
        PyAst.For((GeneratedExpr)t, (GeneratedExpr)ex, (GeneratedStmtSeq)b, (GeneratedStmtSeq?)el, tc.GetCommentValue(), EXTRA) }
    | ASYNC 'for' t=star_targets 'in' ~ ex=star_expressions ':' tc=[TYPE_COMMENT] b=block el=[else_block] {
        CheckVersion(5, "Async for loops are", PyAst.AsyncFor((GeneratedExpr)t, (GeneratedExpr)ex, (GeneratedStmtSeq)b, (GeneratedStmtSeq?)el, tc.GetCommentValue(), EXTRA)) }
    | invalid_for_target

# With statement
# --------------

# CPython: with_stmt[stmt_ty]: ...
# C#: with/async with statement (context manager)
with_stmt[GeneratedStmt]:
    | invalid_with_stmt_indent
    | 'with' '(' a[GeneratedWithitemSeq]=','.with_item+ ','? ')' ':' b=block {
        PyAst.With((GeneratedWithitemSeq)a, (GeneratedStmtSeq)b, null, EXTRA) }
    | 'with' a[GeneratedWithitemSeq]=','.with_item+ ':' tc=[TYPE_COMMENT] b=block {
        PyAst.With((GeneratedWithitemSeq)a, (GeneratedStmtSeq)b, tc.GetCommentValue(), EXTRA) }
    | ASYNC 'with' '(' a[GeneratedWithitemSeq]=','.with_item+ ','? ')' ':' b=block {
       CheckVersion(5, "Async with statements are", PyAst.AsyncWith((GeneratedWithitemSeq)a, (GeneratedStmtSeq)b, null, EXTRA)) }
    | ASYNC 'with' a[GeneratedWithitemSeq]=','.with_item+ ':' tc=[TYPE_COMMENT] b=block {
       CheckVersion(5, "Async with statements are", PyAst.AsyncWith((GeneratedWithitemSeq)a, (GeneratedStmtSeq)b, tc.GetCommentValue(), EXTRA)) }
    | invalid_with_stmt

# CPython: with_item[withitem_ty]: e=expression 'as' t=star_target &(',' | ')' | ':') { _PyAST_withitem(e, t) } | ...
# C#: with item (expression with optional 'as' target)
with_item[GeneratedWithitem]:
    | e=expression 'as' t=star_target &(',' | ')' | ':') { PyAst.withitem((GeneratedExpr)e, (GeneratedExpr)t) }
    | invalid_with_item
    | e=expression { PyAst.withitem((GeneratedExpr)e, null) }

# Try statement
# -------------

# CPython: try_stmt[stmt_ty]: ...
# C#: try/except/else/finally statement (Python 3.11+ supports except*)
try_stmt[GeneratedStmt]:
    | invalid_try_stmt
    | 'try' &&':' b=block f=finally_block { PyAst.Try((GeneratedStmtSeq)b, null, null, (GeneratedStmtSeq)f, EXTRA) }
    | 'try' &&':' b=block ex[GeneratedExcepthandlerSeq]=except_block+ el=[else_block] f=[finally_block] { PyAst.Try((GeneratedStmtSeq)b, (GeneratedExcepthandlerSeq)ex, (GeneratedStmtSeq?)el, (GeneratedStmtSeq?)f, EXTRA) }
    | 'try' &&':' b=block ex[GeneratedExcepthandlerSeq]=except_star_block+ el=[else_block] f=[finally_block] {
        CheckVersion(11, "Exception groups are",
                      PyAst.TryStar((GeneratedStmtSeq)b, (GeneratedExcepthandlerSeq)ex, (GeneratedStmtSeq?)el, (GeneratedStmtSeq?)f, EXTRA)) }


# Except statement
# ----------------

# CPython: except_block[excepthandler_ty]: ...
# C#: except clause (exception handler)
except_block[GeneratedExcepthandler]:
    | invalid_except_stmt_indent
    | 'except' e=expression t=['as' z=NAME { z }] ':' b=block {
        PyAst.ExceptHandler((GeneratedExpr)e, t != null ? ((GeneratedName)NameToken((GeneratedTokenInfo)t)).Id : null, (GeneratedStmtSeq)b, EXTRA) }
    | 'except' ':' b=block { PyAst.ExceptHandler(null, null, (GeneratedStmtSeq)b, EXTRA) }
    | invalid_except_stmt

# CPython: except_star_block[excepthandler_ty]: ...
# C#: except* clause for exception groups (PEP 654, Python 3.11+)
except_star_block[GeneratedExcepthandler]:
    | invalid_except_star_stmt_indent
    | 'except' '*' e=expression t=['as' z=NAME { z }] ':' b=block {
        PyAst.ExceptHandler((GeneratedExpr)e, (t != null) ? ((GeneratedName)NameToken((GeneratedTokenInfo)t)).Id : null, (GeneratedStmtSeq)b, EXTRA) }
    | invalid_except_stmt

# CPython: finally_block[asdl_stmt_seq*]: invalid_finally_stmt | 'finally' &&':' a=block { a }
# C#: finally clause
finally_block[GeneratedStmtSeq]:
    | invalid_finally_stmt
    | 'finally' &&':' a=block { a }

# Match statement
# ---------------

# CPython: match_stmt[stmt_ty]: "match" subject=subject_expr ':' NEWLINE INDENT cases[asdl_match_case_seq*]=case_block+ DEDENT { CHECK_VERSION(stmt_ty, 10, "Pattern matching is", _PyAST_Match(subject, cases, EXTRA)) }
# C#: match statement (structural pattern matching, PEP 634, Python 3.10+)
match_stmt[GeneratedStmt]:
    | "match" subject=subject_expr ':' NEWLINE INDENT cases[GeneratedMatchCaseSeq]=case_block+ DEDENT {
        CheckVersion(10, "Pattern matching is", PyAst.Match((GeneratedExpr)subject, (GeneratedMatchCaseSeq)cases, EXTRA)) }
    | invalid_match_stmt

# CPython: subject_expr[expr_ty]: value=star_named_expression ',' values=star_named_expressions? { _PyAST_Tuple(...) } | named_expression
# C#: match subject expression (can be tuple or single expression)
subject_expr[GeneratedExpr]:
    | value=star_named_expression ',' values=star_named_expressions? {
        PyAst.Tuple(Check<GeneratedExprSeq>(PyParserHelpers.SeqInsertInFront((GeneratedExpr)value, (GeneratedExprSeq?)values).Cast<GeneratedExprSeq>()), Load, EXTRA) }
    | named_expression

# CPython: case_block[match_case_ty]: invalid_case_block | "case" pattern=patterns guard=guard? ':' body=block { _PyAST_match_case(pattern, guard, body) }
# C#: case block in match statement
case_block[GeneratedMatchCase]:
    | invalid_case_block
    | "case" pattern=patterns guard=guard? ':' body=block {
        PyAst.match_case((GeneratedPattern)pattern, (GeneratedExpr?)guard, (GeneratedStmtSeq)body) }

# CPython: guard[expr_ty]: 'if' guard=named_expression { guard }
# C#: guard clause in case block
guard[GeneratedExpr]: 'if' guard=named_expression { guard }

# CPython: patterns[pattern_ty]: patterns[asdl_pattern_seq*]=open_sequence_pattern { _PyAST_MatchSequence(patterns, EXTRA) } | pattern
# C#: patterns (sequence pattern or single pattern)
patterns[GeneratedPattern]:
    | patterns[GeneratedPatternSeq]=open_sequence_pattern {
        PyAst.MatchSequence((GeneratedPatternSeq)patterns, EXTRA) }
    | pattern

# CPython: pattern[pattern_ty]: as_pattern | or_pattern
# C#: pattern (as or or pattern)
pattern[GeneratedPattern]:
    | as_pattern
    | or_pattern

# CPython: as_pattern[pattern_ty]: pattern=or_pattern 'as' target=pattern_capture_target { _PyAST_MatchAs(pattern, target.GetIdentifier(), EXTRA) } | invalid_as_pattern
# C#: as pattern (pattern 'as' name)
as_pattern[GeneratedPattern]:
    | pattern=or_pattern 'as' target=pattern_capture_target {
        PyAst.MatchAs((GeneratedPattern)pattern, target.GetIdentifier(), EXTRA) }
    | invalid_as_pattern

# CPython: or_pattern[pattern_ty]: patterns[asdl_pattern_seq*]='|'.closed_pattern+ { asdl_seq_LEN(patterns) == 1 ? asdl_seq_GET(patterns, 0) : _PyAST_MatchOr(patterns, EXTRA) }
# C#: or pattern (pattern1 | pattern2 | ...)
or_pattern[GeneratedPattern]:
    | patterns[GeneratedPatternSeq]='|'.closed_pattern+ {
        patterns.Count == 1 ? (GeneratedPattern)patterns[0] : PyAst.MatchOr((GeneratedPatternSeq)patterns, EXTRA) }

# CPython: closed_pattern[pattern_ty] (memo): ...
# C#: closed pattern (non-or pattern)
closed_pattern[GeneratedPattern] (memo):
    | a=literal_pattern { a }
    | a=capture_pattern { a }
    | a=wildcard_pattern { a }
    | a=value_pattern { a }
    | a=group_pattern { a }
    | a=sequence_pattern { a }
    | a=mapping_pattern { a }
    | a=class_pattern { a }

# Literal patterns are used for equality and identity constraints
# CPython: literal_pattern[pattern_ty]: ...
# C#: Literal pattern (number, string, None, True, False)
literal_pattern[GeneratedPattern]:
    | value=signed_number !('+' | '-') { PyAst.MatchValue((GeneratedExpr)value, EXTRA) }
    | value=complex_number { PyAst.MatchValue((GeneratedExpr)value, EXTRA) }
    | value=strings { PyAst.MatchValue((GeneratedExpr)value, EXTRA) }
    | 'None' { PyAst.MatchSingleton(GeneratedPyConstant.None, EXTRA) }
    | 'True' { PyAst.MatchSingleton(GeneratedPyConstant.True, EXTRA) }
    | 'False' { PyAst.MatchSingleton(GeneratedPyConstant.False, EXTRA) }

# Literal expressions are used to restrict permitted mapping pattern keys
# CPython: literal_expr[expr_ty]: ...
# C#: Literal expression for mapping keys
literal_expr[GeneratedExpr]:
    | signed_number !('+' | '-')
    | complex_number
    | strings
    | 'None' { PyAst.Constant(GeneratedPyConstant.None, null, EXTRA) }
    | 'True' { PyAst.Constant(GeneratedPyConstant.True, null, EXTRA) }
    | 'False' { PyAst.Constant(GeneratedPyConstant.False, null, EXTRA) }

# CPython: complex_number[expr_ty]: ...
# C#: Complex number (real + imag or real - imag)
complex_number[GeneratedExpr]:
    | real=signed_real_number '+' imag=imaginary_number {
        PyAst.BinOp((GeneratedExpr)real, Add, (GeneratedExpr)imag, EXTRA) }
    | real=signed_real_number '-' imag=imaginary_number  {
        PyAst.BinOp((GeneratedExpr)real, Sub, (GeneratedExpr)imag, EXTRA) }

# CPython: signed_number[expr_ty]: NUMBER | '-' number=NUMBER { _PyAST_UnaryOp(USub, number, EXTRA) }
# C#: Signed number (positive or negative)
signed_number[GeneratedExpr]:
    | number=NUMBER { NumberToken(number) }
    | '-' number=NUMBER { PyAst.UnaryOp(USub, NumberToken(number), EXTRA) }

# CPython: signed_real_number[expr_ty]: real_number | '-' real=real_number { _PyAST_UnaryOp(USub, real, EXTRA) }
# C#: Signed real number
signed_real_number[GeneratedExpr]:
    | real_number
    | '-' real=real_number { PyAst.UnaryOp(USub, (GeneratedExpr)real, EXTRA) }

# CPython: real_number[expr_ty]: real=NUMBER { _PyPegen_ensure_real(real) }
# C#: Real number (ensure it's not complex)
real_number[GeneratedExpr]:
    | real=NUMBER { PyParserHelpers.EnsureReal(NumberToken(real)) }

# CPython: imaginary_number[expr_ty]: imag=NUMBER { _PyPegen_ensure_imaginary(imag) }
# C#: Imaginary number (ensure it has 'j' suffix)
imaginary_number[GeneratedExpr]:
    | imag=NUMBER { PyParserHelpers.EnsureImaginary(NumberToken(imag)) }

# CPython: capture_pattern[pattern_ty]: target=pattern_capture_target { _PyAST_MatchAs(null, target.GetIdentifier(), EXTRA) }
# C#: Capture pattern (variable name)
capture_pattern[GeneratedPattern]:
    | target=pattern_capture_target { PyAst.MatchAs(null, target.GetIdentifier(), EXTRA) }

# CPython: pattern_capture_target[expr_ty]: !"_" name=NAME !('.' | '(' | '=') { SetExprContext(name, Store) }
# C#: Pattern capture target (name that's not '_')
pattern_capture_target[GeneratedExpr]:
    | !"_" name=NAME !('.' | '(' | '=') {
        PyParserHelpers.SetExprContext(NameToken(name), Store) }

# CPython: wildcard_pattern[pattern_ty]: "_" { _PyAST_MatchAs(null, null, EXTRA) }
# C#: Wildcard pattern (_)
wildcard_pattern[GeneratedPattern]:
    | "_" { PyAst.MatchAs(null, null, EXTRA) }

# CPython: value_pattern[pattern_ty]: attr=attr !('.' | '(' | '=') { _PyAST_MatchValue(attr, EXTRA) }
# C#: Value pattern (dotted name like Color.RED)
value_pattern[GeneratedPattern]:
    | attr=attr !('.' | '(' | '=') { PyAst.MatchValue((GeneratedExpr)attr, EXTRA) }

# CPython: attr[expr_ty]: value=name_or_attr '.' attr=NAME { _PyAST_Attribute(value, attr.Id, Load, EXTRA) }
# C#: Attribute access (obj.attr)
attr[GeneratedExpr]:
    | value=name_or_attr '.' attr=NAME {
        PyAst.Attribute((GeneratedExpr)value, attr.Value, Load, EXTRA) }

# CPython: name_or_attr[expr_ty]: attr | NAME
# C#: Name or attribute
name_or_attr[GeneratedExpr]:
    | attr
    | NAME

# CPython: group_pattern[pattern_ty]: '(' pattern=pattern ')' { pattern }
# C#: Group pattern (parenthesized pattern)
group_pattern[GeneratedPattern]:
    | '(' pattern=pattern ')' { pattern }

# CPython: sequence_pattern[pattern_ty]: '[' patterns=maybe_sequence_pattern? ']' { _PyAST_MatchSequence(...) } | '(' patterns=open_sequence_pattern? ')' { _PyAST_MatchSequence(...) }
# C#: Sequence pattern ([a, b, c] or (a, b, c))
sequence_pattern[GeneratedPattern]:
    | '[' patterns=maybe_sequence_pattern? ']' { PyAst.MatchSequence((GeneratedPatternSeq?)patterns, EXTRA) }
    | '(' patterns=open_sequence_pattern? ')' { PyAst.MatchSequence((GeneratedPatternSeq?)patterns, EXTRA) }

# CPython: open_sequence_pattern[asdl_seq*]: pattern=maybe_star_pattern ',' patterns=maybe_sequence_pattern? { SeqInsertInFront(pattern, patterns) }
# C#: Open sequence pattern (at least one comma)
open_sequence_pattern[GeneratedSeq]:
    | pattern=maybe_star_pattern ',' patterns=maybe_sequence_pattern? {
        PyParserHelpers.SeqInsertInFront((GeneratedPattern)pattern, (GeneratedSeq?)patterns).Cast<GeneratedPatternSeq>() }

# CPython: maybe_sequence_pattern[asdl_seq*]: patterns=','.maybe_star_pattern+ ','? { patterns }
# C#: Maybe sequence pattern (comma-separated)
maybe_sequence_pattern[GeneratedSeq]:
    | patterns=','.maybe_star_pattern+ ','? { patterns.Cast<GeneratedPatternSeq>() }

# CPython: maybe_star_pattern[pattern_ty]: star_pattern | pattern
# C#: Maybe star pattern (*rest or regular pattern)
maybe_star_pattern[GeneratedPattern]:
    | star_pattern
    | pattern

# CPython: star_pattern[pattern_ty] (memo): '*' target=pattern_capture_target { _PyAST_MatchStar(...) } | '*' wildcard_pattern { _PyAST_MatchStar(null, EXTRA) }
# C#: Star pattern (*rest or *_)
star_pattern[GeneratedPattern] (memo):
    | '*' target=pattern_capture_target {
        PyAst.MatchStar(target.GetIdentifier(), EXTRA) }
    | '*' wildcard_pattern {
        PyAst.MatchStar(null, EXTRA) }

# CPython: mapping_pattern[pattern_ty]: ...
# C#: Mapping pattern ({key: value, ...})
mapping_pattern[GeneratedPattern]:
    | '{' '}' {
        PyAst.MatchMapping(null, null, null, EXTRA) }
    | '{' rest=double_star_pattern ','? '}' {
        PyAst.MatchMapping(null, null, rest.GetIdentifier(), EXTRA) }
    | '{' items=items_pattern ',' rest=double_star_pattern ','? '}' {
        PyAst.MatchMapping(
            Check<GeneratedExprSeq>(PyParserHelpers.GetPatternKeys(items)),
            Check<GeneratedPatternSeq>(PyParserHelpers.GetPatterns(items)),
            rest.GetIdentifier(),
            EXTRA) }
    | '{' items=items_pattern ','? '}' {
        PyAst.MatchMapping(
            Check<GeneratedExprSeq>(PyParserHelpers.GetPatternKeys(items)),
            Check<GeneratedPatternSeq>(PyParserHelpers.GetPatterns(items)),
            null,
            EXTRA) }

# CPython: items_pattern[asdl_seq*]: ','.key_value_pattern+
# C#: Items pattern (key: value pairs)
items_pattern[GeneratedSeq]:
    | ','.key_value_pattern+

# CPython: key_value_pattern[KeyPatternPair*]: key=(literal_expr | attr) ':' pattern=pattern { KeyPatternPair(key, pattern) }
# C#: Key-value pattern pair
key_value_pattern[GeneratedKeyPatternPair]:
    | key=(literal_expr | attr) ':' pattern=pattern {
        PyParserHelpers.KeyPatternPair((GeneratedExpr)key, (GeneratedPattern)pattern) }

# CPython: double_star_pattern[expr_ty]: '**' target=pattern_capture_target { target }
# C#: Double star pattern (**rest)
double_star_pattern[GeneratedExpr]:
    | '**' target=pattern_capture_target { target }

# CPython: class_pattern[pattern_ty]: ...
# C#: Class pattern (ClassName(...))
class_pattern[GeneratedPattern]:
    | cls=name_or_attr '(' ')' {
        PyAst.MatchClass((GeneratedExpr)cls, null, null, null, EXTRA) }
    | cls=name_or_attr '(' patterns=positional_patterns ','? ')' {
        PyAst.MatchClass((GeneratedExpr)cls, (GeneratedPatternSeq)patterns, null, null, EXTRA) }
    | cls=name_or_attr '(' keywords=keyword_patterns ','? ')' {
        PyAst.MatchClass(
            (GeneratedExpr)cls, null,
            Check<GeneratedIdentifierSeq>(PyParserHelpers.MapNamesToIds(
                Check<GeneratedExprSeq>(PyParserHelpers.GetPatternKeys((GeneratedSeq)keywords)))),
            Check<GeneratedPatternSeq>(PyParserHelpers.GetPatterns((GeneratedSeq)keywords)),
            EXTRA) }
    | cls=name_or_attr '(' patterns=positional_patterns ',' keywords=keyword_patterns ','? ')' {
        PyAst.MatchClass(
            (GeneratedExpr)cls,
            (GeneratedPatternSeq)patterns,
            Check<GeneratedIdentifierSeq>(PyParserHelpers.MapNamesToIds(
                Check<GeneratedExprSeq>(PyParserHelpers.GetPatternKeys((GeneratedSeq)keywords)))),
            Check<GeneratedPatternSeq>(PyParserHelpers.GetPatterns((GeneratedSeq)keywords)),
            EXTRA) }
    | invalid_class_pattern

# CPython: positional_patterns[asdl_pattern_seq*]: args[asdl_pattern_seq*]=','.pattern+ { args }
# C#: Positional patterns
positional_patterns[GeneratedPatternSeq]:
    | args[GeneratedPatternSeq]=','.pattern+ { args }

# CPython: keyword_patterns[asdl_seq*]: ','.keyword_pattern+
# C#: Keyword patterns
keyword_patterns[GeneratedSeq]:
    | ','.keyword_pattern+

# CPython: keyword_pattern[KeyPatternPair*]: arg=NAME '=' value=pattern { KeyPatternPair(arg, value) }
# C#: Keyword pattern pair
keyword_pattern[GeneratedKeyPatternPair]:
    | arg=NAME '=' value=pattern { PyParserHelpers.KeyPatternPair(NameToken(arg), (GeneratedPattern)value) }

# Type statement
# ---------------

# CPython: type_alias[stmt_ty]: "type" n=NAME t=[type_params] '=' b=expression { CHECK_VERSION(stmt_ty, 12, "Type statement is", _PyAST_TypeAlias(...)) }
# C#: Type alias statement (PEP 695, Python 3.12+)
type_alias[GeneratedStmt]:
    | "type" n=NAME t=[type_params] '=' b=expression {
        CheckVersion(12, "Type statement is",
        PyAst.TypeAlias(Check<GeneratedExpr>(PyParserHelpers.SetExprContext(NameToken(n), Store)), (GeneratedTypeParamSeq?)t, (GeneratedExpr)b, EXTRA)) }

# Type parameter declaration
# --------------------------

# CPython: type_params[asdl_type_param_seq*]: '[' t=type_param_seq  ']' { CHECK_VERSION(asdl_type_param_seq *, 12, "Type parameter lists are", t) }
# C#: Type parameters [T, U, ...]
type_params[GeneratedTypeParamSeq]: '[' t=type_param_seq  ']' {
        CheckVersion(12, "Type parameter lists are", t) }

# CPython: type_param_seq[asdl_type_param_seq*]: a[asdl_type_param_seq*]=','.type_param+ [','] { a }
# C#: Type parameter sequence
type_param_seq[GeneratedTypeParamSeq]: a[GeneratedTypeParamSeq]=','.type_param+ [','] { a }

# CPython: type_param[type_param_ty] (memo): ...
# C#: Type parameter (TypeVar, TypeVarTuple, ParamSpec)
type_param[GeneratedTypeParam] (memo):
    | a=NAME b=[type_param_bound] { PyAst.TypeVar(a.GetNameValue(), (GeneratedExpr?)b, EXTRA) }
    | '*' a=NAME colon=':' e=expression {
            RaiseSyntaxErrorStartingFrom(colon, (GeneratedExpr)e is GeneratedTuple
                ? "cannot use constraints with TypeVarTuple"
                : "cannot use bound with TypeVarTuple")
        }
    | '*' a=NAME { PyAst.TypeVarTuple(a.GetNameValue(), EXTRA) }
    | '**' a=NAME colon=':' e=expression {
            RaiseSyntaxErrorStartingFrom(colon, (GeneratedExpr)e is GeneratedTuple
                ? "cannot use constraints with ParamSpec"
                : "cannot use bound with ParamSpec")
        }
    | '**' a=NAME { PyAst.ParamSpec(a.GetNameValue(), EXTRA) }

# CPython: type_param_bound[expr_ty]: ':' e=expression { e }
# C#: Type parameter bound (T: Bound)
type_param_bound[GeneratedExpr]: ':' e=expression { e }

# EXPRESSIONS
# -----------
# CPython 3.12 Grammar: Parser/python.gram (lines 477-615)
#
# C → C# 타입 변환:
# - [expr_ty] → [GeneratedExpr] (expression)
# - [asdl_expr_seq*] → [GeneratedExprSeq] (expression sequence)
# - [CmpopExprPair*] → [GeneratedCmpopExprPair] (comparison operator-expression pair)

# CPython: expressions[expr_ty]: ...
# C#: Multiple expressions (can form tuple)
expressions[GeneratedExpr]:
    | a=expression b=(',' c=expression { c })+ [','] {
        PyAst.Tuple(Check<GeneratedExprSeq>(PyParserHelpers.SeqInsertInFront((GeneratedExpr)a, (GeneratedSeq)b).Cast<GeneratedExprSeq>()), Load, EXTRA) }
    | a=expression ',' { PyAst.Tuple(Check<GeneratedExprSeq>(PyParserHelpers.SingletonSequence((GeneratedExpr)a).Cast<GeneratedExprSeq>()), Load, EXTRA) }
    | expression

# CPython: expression[expr_ty] (memo): ...
# C#: Single expression (if-else, or, and, not, comparison, etc.)
expression[GeneratedExpr] (memo):
    | invalid_expression
    | invalid_legacy_expression
    | a=disjunction 'if' b=disjunction 'else' c=expression { PyAst.IfExp((GeneratedExpr)b, (GeneratedExpr)a, (GeneratedExpr)c, EXTRA) }
    | disjunction
    | lambdef

# CPython: yield_expr[expr_ty]: 'yield' 'from' a=expression { _PyAST_YieldFrom(a, EXTRA) } | 'yield' a=[star_expressions] { _PyAST_Yield(a, EXTRA) }
# C#: Yield expression (yield or yield from)
yield_expr[GeneratedExpr]:
    | 'yield' 'from' a=expression { PyAst.YieldFrom((GeneratedExpr)a, EXTRA) }
    | 'yield' a=[star_expressions] { PyAst.Yield((GeneratedExpr?)a, EXTRA) }

# CPython: star_expressions[expr_ty]: ...
# C#: Star expressions (*x, can form tuple)
star_expressions[GeneratedExpr]:
    | a=star_expression b=(',' c=star_expression { c })+ [','] {
        PyAst.Tuple(Check<GeneratedExprSeq>(PyParserHelpers.SeqInsertInFront((GeneratedExpr)a, (GeneratedSeq)b).Cast<GeneratedExprSeq>()), Load, EXTRA) }
    | a=star_expression ',' { PyAst.Tuple(Check<GeneratedExprSeq>(PyParserHelpers.SingletonSequence((GeneratedExpr)a).Cast<GeneratedExprSeq>()), Load, EXTRA) }
    | star_expression

# CPython: star_expression[expr_ty] (memo): '*' a=bitwise_or { _PyAST_Starred(a, Load, EXTRA) } | expression
# C#: Star expression (*x or regular expression)
star_expression[GeneratedExpr] (memo):
    | '*' a=bitwise_or { PyAst.Starred((GeneratedExpr)a, Load, EXTRA) }
    | expression

# CPython: star_named_expressions[asdl_expr_seq*]: a[asdl_expr_seq*]=','.star_named_expression+ [','] { a }
# C#: Comma-separated star named expressions
star_named_expressions[GeneratedExprSeq]: a[GeneratedExprSeq]=','.star_named_expression+ [','] { a }

# CPython: star_named_expression[expr_ty]: '*' a=bitwise_or { _PyAST_Starred(a, Load, EXTRA) } | named_expression
# C#: Star named expression (*x or named expression)
star_named_expression[GeneratedExpr]:
    | '*' a=bitwise_or { PyAst.Starred((GeneratedExpr)a, Load, EXTRA) }
    | named_expression

# CPython: assignment_expression[expr_ty]: a=NAME ':=' ~ b=expression { CHECK_VERSION(expr_ty, 8, "Assignment expressions are", _PyAST_NamedExpr(...)) }
# C#: Assignment expression (walrus operator :=, PEP 572, Python 3.8+)
assignment_expression[GeneratedExpr]:
    | a=NAME ':=' ~ b=expression {
        CheckVersion(8, "Assignment expressions are",
        PyAst.NamedExpr(Check<GeneratedExpr>(PyParserHelpers.SetExprContext(NameToken(a), Store)), (GeneratedExpr)b, EXTRA)) }

# CPython: named_expression[expr_ty]: assignment_expression | invalid_named_expression | expression !':='
# C#: Named expression (assignment or regular expression)
named_expression[GeneratedExpr]:
    | assignment_expression
    | invalid_named_expression
    | expression !':='

# CPython: disjunction[expr_ty] (memo): a=conjunction b=('or' c=conjunction { c })+ { _PyAST_BoolOp(Or, ...) } | conjunction
# C#: Disjunction (or)
disjunction[GeneratedExpr] (memo):
    | a=conjunction b=('or' c=conjunction { c })+ { PyAst.BoolOp(
        Or,
        Check<GeneratedExprSeq>(PyParserHelpers.SeqInsertInFront((GeneratedExpr)a, (GeneratedSeq)b).Cast<GeneratedExprSeq>()),
        EXTRA) }
    | conjunction

# CPython: conjunction[expr_ty] (memo): a=inversion b=('and' c=inversion { c })+ { _PyAST_BoolOp(And, ...) } | inversion
# C#: Conjunction (and)
conjunction[GeneratedExpr] (memo):
    | a=inversion b=('and' c=inversion { c })+ { PyAst.BoolOp(
        And,
        Check<GeneratedExprSeq>(PyParserHelpers.SeqInsertInFront((GeneratedExpr)a, (GeneratedSeq)b).Cast<GeneratedExprSeq>()),
        EXTRA) }
    | inversion

# CPython: inversion[expr_ty] (memo): 'not' a=inversion { _PyAST_UnaryOp(Not, a, EXTRA) } | comparison
# C#: Inversion (not)
inversion[GeneratedExpr] (memo):
    | 'not' a=inversion { PyAst.UnaryOp(Not, (GeneratedExpr)a, EXTRA) }
    | comparison

# Comparison operators
# --------------------

# CPython: comparison[expr_ty]: a=bitwise_or b=compare_op_bitwise_or_pair+ { _PyAST_Compare(a, ...) } | bitwise_or
# C#: Comparison (==, !=, <, >, etc.)
comparison[GeneratedExpr]:
    | a=bitwise_or b=compare_op_bitwise_or_pair+ {
        PyAst.Compare(
            (GeneratedExpr)a,
            Check<GeneratedCmpopSeq>(PyParserHelpers.GetCmpops((GeneratedSeq)b).Cast<GeneratedCmpopSeq>()),
            Check<GeneratedExprSeq>(PyParserHelpers.GetExprs((GeneratedSeq)b)),
            EXTRA) }
    | bitwise_or

# CPython: compare_op_bitwise_or_pair[CmpopExprPair*]: ...
# C#: Comparison operator-expression pair
compare_op_bitwise_or_pair[GeneratedCmpopExprPair]:
    | eq_bitwise_or
    | noteq_bitwise_or
    | lte_bitwise_or
    | lt_bitwise_or
    | gte_bitwise_or
    | gt_bitwise_or
    | notin_bitwise_or
    | in_bitwise_or
    | isnot_bitwise_or
    | is_bitwise_or

# CPython: eq_bitwise_or[CmpopExprPair*]: '==' a=bitwise_or { _PyPegen_cmpop_expr_pair(Eq, a) }
# C#: Individual comparison operators
eq_bitwise_or[GeneratedCmpopExprPair]: '==' a=bitwise_or { PyParserHelpers.CmpopExprPair(Eq, (GeneratedExpr)a) }
noteq_bitwise_or[GeneratedCmpopExprPair]:
    | (tok='!=' { ASTHelpers.CheckBarryAsFlufl(tok) ? null : tok}) a=bitwise_or {PyParserHelpers.CmpopExprPair(NotEq, (GeneratedExpr)a) }
lte_bitwise_or[GeneratedCmpopExprPair]: '<=' a=bitwise_or { PyParserHelpers.CmpopExprPair(LtE, (GeneratedExpr)a) }
lt_bitwise_or[GeneratedCmpopExprPair]: '<' a=bitwise_or { PyParserHelpers.CmpopExprPair(Lt, (GeneratedExpr)a) }
gte_bitwise_or[GeneratedCmpopExprPair]: '>=' a=bitwise_or { PyParserHelpers.CmpopExprPair(GtE, (GeneratedExpr)a) }
gt_bitwise_or[GeneratedCmpopExprPair]: '>' a=bitwise_or { PyParserHelpers.CmpopExprPair(Gt, (GeneratedExpr)a) }
notin_bitwise_or[GeneratedCmpopExprPair]: 'not' 'in' a=bitwise_or { PyParserHelpers.CmpopExprPair(NotIn, (GeneratedExpr)a) }
in_bitwise_or[GeneratedCmpopExprPair]: 'in' a=bitwise_or { PyParserHelpers.CmpopExprPair(In, (GeneratedExpr)a) }
isnot_bitwise_or[GeneratedCmpopExprPair]: 'is' 'not' a=bitwise_or { PyParserHelpers.CmpopExprPair(IsNot, (GeneratedExpr)a) }
is_bitwise_or[GeneratedCmpopExprPair]: 'is' a=bitwise_or { PyParserHelpers.CmpopExprPair(Is, (GeneratedExpr)a) }

# Bitwise operators
# -----------------

# CPython: bitwise_or[expr_ty]: a=bitwise_or '|' b=bitwise_xor { _PyAST_BinOp(a, BitOr, b, EXTRA) } | bitwise_xor
# C#: Bitwise OR (|)
bitwise_or[GeneratedExpr]:
    | a=bitwise_or '|' b=bitwise_xor { PyAst.BinOp((GeneratedExpr)a, BitOr, (GeneratedExpr)b, EXTRA) }
    | bitwise_xor

# CPython: bitwise_xor[expr_ty]: a=bitwise_xor '^' b=bitwise_and { _PyAST_BinOp(a, BitXor, b, EXTRA) } | bitwise_and
# C#: Bitwise XOR (^)
bitwise_xor[GeneratedExpr]:
    | a=bitwise_xor '^' b=bitwise_and { PyAst.BinOp((GeneratedExpr)a, BitXor, (GeneratedExpr)b, EXTRA) }
    | bitwise_and

# CPython: bitwise_and[expr_ty]: a=bitwise_and '&' b=shift_expr { _PyAST_BinOp(a, BitAnd, b, EXTRA) } | shift_expr
# C#: Bitwise AND (&)
bitwise_and[GeneratedExpr]:
    | a=bitwise_and '&' b=shift_expr { PyAst.BinOp((GeneratedExpr)a, BitAnd, (GeneratedExpr)b, EXTRA) }
    | shift_expr

# CPython: shift_expr[expr_ty]: a=shift_expr '<<' b=sum { _PyAST_BinOp(a, LShift, b, EXTRA) } | ...
# C#: Shift expressions (<< >>)
shift_expr[GeneratedExpr]:
    | a=shift_expr '<<' b=sum { PyAst.BinOp((GeneratedExpr)a, LShift, (GeneratedExpr)b, EXTRA) }
    | a=shift_expr '>>' b=sum { PyAst.BinOp((GeneratedExpr)a, RShift, (GeneratedExpr)b, EXTRA) }
    | sum

# Arithmetic operators
# --------------------

# CPython: sum[expr_ty]: a=sum '+' b=term { _PyAST_BinOp(a, Add, b, EXTRA) } | ...
# C#: Addition and subtraction (+ -)
sum[GeneratedExpr]:
    | a=sum '+' b=term { PyAst.BinOp((GeneratedExpr)a, Add, (GeneratedExpr)b, EXTRA) }
    | a=sum '-' b=term { PyAst.BinOp((GeneratedExpr)a, Sub, (GeneratedExpr)b, EXTRA) }
    | term

# CPython: term[expr_ty]: ...
# C#: Multiplication, division, modulo, matrix multiplication (* / // % @)
term[GeneratedExpr]:
    | a=term '*' b=factor { PyAst.BinOp((GeneratedExpr)a, Mult, (GeneratedExpr)b, EXTRA) }
    | a=term '/' b=factor { PyAst.BinOp((GeneratedExpr)a, Div, (GeneratedExpr)b, EXTRA) }
    | a=term '//' b=factor { PyAst.BinOp((GeneratedExpr)a, FloorDiv, (GeneratedExpr)b, EXTRA) }
    | a=term '%' b=factor { PyAst.BinOp((GeneratedExpr)a, Mod, (GeneratedExpr)b, EXTRA) }
    | a=term '@' b=factor { CheckVersion(5, "The '@' operator is", PyAst.BinOp((GeneratedExpr)a, MatMult, (GeneratedExpr)b, EXTRA)) }
    | factor

# CPython: factor[expr_ty] (memo): '+' a=factor { _PyAST_UnaryOp(UAdd, a, EXTRA) } | ...
# C#: Unary operators (+ - ~)
factor[GeneratedExpr] (memo):
    | '+' a=factor { PyAst.UnaryOp(UAdd, (GeneratedExpr)a, EXTRA) }
    | '-' a=factor { PyAst.UnaryOp(USub, (GeneratedExpr)a, EXTRA) }
    | '~' a=factor { PyAst.UnaryOp(Invert, (GeneratedExpr)a, EXTRA) }
    | power

# CPython: power[expr_ty]: a=await_primary '**' b=factor { _PyAST_BinOp(a, Pow, b, EXTRA) } | await_primary
# C#: Power operator (**)
power[GeneratedExpr]:
    | a=await_primary '**' b=factor { PyAst.BinOp((GeneratedExpr)a, Pow, (GeneratedExpr)b, EXTRA) }
    | await_primary

# Primary elements
# ----------------

# Primary elements are things like "obj.something.something", "obj[something]", "obj(something)", "obj" ...

# CPython: await_primary[expr_ty] (memo): AWAIT a=primary { CHECK_VERSION(expr_ty, 5, "Await expressions are", _PyAST_Await(a, EXTRA)) } | primary
# C#: Await expression (Python 3.5+)
await_primary[GeneratedExpr] (memo):
    | AWAIT a=primary { CheckVersion(5, "Await expressions are", PyAst.Await((GeneratedExpr)a, EXTRA)) }
    | primary

# CPython: primary[expr_ty]: ...
# C#: Primary expressions (attribute, call, subscript, atom)
primary[GeneratedExpr]:
    | a=primary '.' b=NAME { PyAst.Attribute((GeneratedExpr)a, b.GetNameValue(), Load, EXTRA) }
    | a=primary b=genexp { PyAst.Call((GeneratedExpr)a, Check<GeneratedExprSeq>(PyParserHelpers.SingletonSequence((GeneratedExpr)b).Cast<GeneratedExprSeq>()), null, EXTRA) }
    | a=primary '(' b=[arguments] ')' {
        PyAst.Call((GeneratedExpr)a,
                 (b != null) ? ((GeneratedCall)b).Args : null!,
                 (b != null) ? ((GeneratedCall)b).Keywords : null!,
                 EXTRA) }
    | a=primary '[' b=slices ']' { PyAst.Subscript((GeneratedExpr)a, (GeneratedExpr)b, Load, EXTRA) }
    | atom

# CPython: slices[expr_ty]: a=slice !',' { a } | a[asdl_expr_seq*]=','.(slice | starred_expression)+ [','] { _PyAST_Tuple(a, Load, EXTRA) }
# C#: Slices (single or tuple of slices)
slices[GeneratedExpr]:
    | a=slice !',' { a }
    | a[GeneratedExprSeq]=','.(slice | starred_expression)+ [','] { PyAst.Tuple(a, Load, EXTRA) }

# CPython: slice[expr_ty]: a=[expression] ':' b=[expression] c=[':' d=[expression] { d }] { _PyAST_Slice(a, b, c, EXTRA) } | a=named_expression { a }
# C#: Slice (start:stop:step or expression)
slice[GeneratedExpr]:
    | a=[expression] ':' b=[expression] c=[':' d=[expression] { d }] { PyAst.Slice((GeneratedExpr?)a, (GeneratedExpr?)b, (GeneratedExpr?)c, EXTRA) }
    | a=named_expression { a }

# CPython: atom[expr_ty]: ...
# C#: Atomic expressions (NAME, literals, collections)
atom[GeneratedExpr]:
    | name=NAME { NameToken(name) }
    | 'True' { PyAst.Constant(GeneratedPyConstant.True, null, EXTRA) }
    | 'False' { PyAst.Constant(GeneratedPyConstant.False, null, EXTRA) }
    | 'None' { PyAst.Constant(GeneratedPyConstant.None, null, EXTRA) }
    | &(STRING|FSTRING_START) strings
    | number=NUMBER { NumberToken(number) }
    | &'(' (tuple | group | genexp)
    | &'[' (list | listcomp)
    | &'{' (dict | set | dictcomp | setcomp)
    | '...' { PyAst.Constant(GeneratedPyConstant.Ellipsis, null, EXTRA) }

# CPython: group[expr_ty]: '(' a=(yield_expr | named_expression) ')' { a } | invalid_group
# C#: Parenthesized expression
group[GeneratedExpr]:
    | '(' a=(yield_expr | named_expression) ')' { (GeneratedExpr)a }
    | invalid_group

# Lambda functions
# ----------------

# CPython: lambdef[expr_ty]: 'lambda' a=[lambda_params] ':' b=expression { _PyAST_Lambda((a) ? a : CHECK<arguments_ty>(EmptyArguments()), b, EXTRA) }
# C#: Lambda function
lambdef[GeneratedExpr]:
    | 'lambda' a=[lambda_params] ':' b=expression {
        PyAst.Lambda((a != null) ? a : (GeneratedArguments)Check<GeneratedArguments>(PyParserHelpers.EmptyArguments()), b, EXTRA) }

# CPython: lambda_params[arguments_ty]: invalid_lambda_parameters | lambda_parameters
# C#: Lambda parameters
lambda_params[GeneratedArguments]:
    | a=invalid_lambda_parameters { (GeneratedArguments)a }
    | a=lambda_parameters { (GeneratedArguments)a }

# lambda_parameters etc. duplicates parameters but without annotations
# or type comments, and if there's no comma after a parameter, we expect
# a colon, not a close parenthesis.  (For more, see parameters above.)
#
# CPython: lambda_parameters[arguments_ty]: ...
# C#: Lambda parameters (same as parameters but without annotations)
lambda_parameters[GeneratedArguments]:
    | a=lambda_slash_no_default b[GeneratedArgSeq]=lambda_param_no_default* c=lambda_param_with_default* d=[lambda_star_etc] {
        CheckVersion(8, "Positional-only parameters are", PyParserHelpers.MakeArguments((GeneratedArgSeq)a, null, b, c?.Cast<GeneratedNameDefaultPairSeq>(), (GeneratedStarEtc?)d)) }
    | a=lambda_slash_with_default b=lambda_param_with_default* c=[lambda_star_etc] {
        CheckVersion(8, "Positional-only parameters are", PyParserHelpers.MakeArguments(null, (GeneratedSlashWithDefault)a, null, b?.Cast<GeneratedNameDefaultPairSeq>(), (GeneratedStarEtc?)c)) }
    | a[GeneratedArgSeq]=lambda_param_no_default+ b=lambda_param_with_default* c=[lambda_star_etc] {
        PyParserHelpers.MakeArguments(null, null, a, b?.Cast<GeneratedNameDefaultPairSeq>(), (GeneratedStarEtc?)c) }
    | a=lambda_param_with_default+ b=[lambda_star_etc] { PyParserHelpers.MakeArguments(null, null, null, a?.Cast<GeneratedNameDefaultPairSeq>(), (GeneratedStarEtc?)b)}
    | a=lambda_star_etc { PyParserHelpers.MakeArguments(null, null, null, null, (GeneratedStarEtc)a) }

# CPython: lambda_slash_no_default[asdl_arg_seq*]: ...
# C#: Lambda positional-only parameters without defaults
lambda_slash_no_default[GeneratedArgSeq]:
    | a[GeneratedArgSeq]=lambda_param_no_default+ '/' ',' { a }
    | a[GeneratedArgSeq]=lambda_param_no_default+ '/' &':' { a }

# CPython: lambda_slash_with_default[SlashWithDefault*]: ...
# C#: Lambda positional-only parameters with defaults
lambda_slash_with_default[GeneratedSlashWithDefault]:
    | a=lambda_param_no_default* b=lambda_param_with_default+ '/' ',' { PyParserHelpers.SlashWithDefault(a?.Cast<GeneratedArgSeq>(), b?.Cast<GeneratedNameDefaultPairSeq>()) }
    | a=lambda_param_no_default* b=lambda_param_with_default+ '/' &':' { PyParserHelpers.SlashWithDefault(a?.Cast<GeneratedArgSeq>(), b?.Cast<GeneratedNameDefaultPairSeq>()) }

# CPython: lambda_star_etc[StarEtc*]: ...
# C#: Lambda *args and **kwargs
lambda_star_etc[GeneratedStarEtc]:
    | invalid_lambda_star_etc
    | '*' a=lambda_param_no_default b=lambda_param_maybe_default* c=[lambda_kwds] {
        PyParserHelpers.StarEtc((GeneratedArg)a, b?.Cast<GeneratedNameDefaultPairSeq>(), (GeneratedArg?)c) }
    | '*' ',' b=lambda_param_maybe_default+ c=[lambda_kwds] {
        PyParserHelpers.StarEtc(null, b?.Cast<GeneratedNameDefaultPairSeq>(), (GeneratedArg?)c) }
    | a=lambda_kwds { PyParserHelpers.StarEtc(null, null, (GeneratedArg)a) }

# CPython: lambda_kwds[arg_ty]: ...
# C#: Lambda **kwargs
lambda_kwds[GeneratedArg]:
    | invalid_lambda_kwds
    | '**' a=lambda_param_no_default { a }

# CPython: lambda_param_no_default[arg_ty]: ...
# C#: Lambda parameter without default
lambda_param_no_default[GeneratedArg]:
    | a=lambda_param ',' { a }
    | a=lambda_param &':' { a }

# CPython: lambda_param_with_default[NameDefaultPair*]: ...
# C#: Lambda parameter with default
lambda_param_with_default[GeneratedNameDefaultPair]:
    | a=lambda_param c=default ',' { PyParserHelpers.NameDefaultPair((GeneratedArg)a, (GeneratedExpr)c, null) }
    | a=lambda_param c=default &':' { PyParserHelpers.NameDefaultPair((GeneratedArg)a, (GeneratedExpr)c, null) }

# CPython: lambda_param_maybe_default[NameDefaultPair*]: ...
# C#: Lambda parameter with optional default
lambda_param_maybe_default[GeneratedNameDefaultPair]:
    | a=lambda_param c=default? ',' { PyParserHelpers.NameDefaultPair((GeneratedArg)a, (GeneratedExpr?)c, null) }
    | a=lambda_param c=default? &':' { PyParserHelpers.NameDefaultPair((GeneratedArg)a, (GeneratedExpr?)c, null) }

# CPython: lambda_param[arg_ty]: a=NAME { _PyAST_arg(a.GetNameValue(), null, null, EXTRA) }
# C#: Lambda parameter (no annotation)
lambda_param[GeneratedArg]: a=NAME { PyAst.arg(a.GetNameValue(), null, null, EXTRA) }

# LITERALS
# ========
# CPython 3.12 Grammar: Parser/python.gram (lines 617-662)

# F-strings (formatted string literals)
# CPython: fstring_middle[expr_ty]: ...
# C#: F-string middle component (replacement field or constant text)
fstring_middle[GeneratedExpr]:
    | fstring_replacement_field
    | t=FSTRING_MIDDLE { ConstantFromToken(t) }

# CPython: fstring_replacement_field[expr_ty]: ...
# C#: F-string {expression} replacement field
fstring_replacement_field[GeneratedExpr]:
    | '{' a=(yield_expr | star_expressions) debug_expr='='? conversion=[fstring_conversion] format=[fstring_full_format_spec] rbrace='}' {
        FormattedValue((GeneratedExpr)a, debug_expr, conversion, format, rbrace, EXTRA) }
    | invalid_replacement_field

# CPython: fstring_conversion[ResultTokenWithMetadata]: ...
# C#: F-string conversion (!s, !r, !a)
fstring_conversion[GeneratedResultTokenWithMetadata]:
    | conv_token="!" conv=NAME { CheckFstringConversion(conv_token, NameToken(conv)) }

# CPython: fstring_full_format_spec[ResultTokenWithMetadata]: ...
# C#: F-string format spec (:format)
fstring_full_format_spec[GeneratedExpr]:
    | colon=':' spec=fstring_format_spec* { SetupFullFormatSpec(colon, spec.Cast<GeneratedExprSeq>(), EXTRA) }

# CPython: fstring_format_spec[expr_ty]: ...
# C#: F-string format spec component
fstring_format_spec[GeneratedExpr]:
    | t=FSTRING_MIDDLE { PyParserHelpers.DecodedConstantFromToken(t) }
    | fstring_replacement_field

# CPython: fstring[expr_ty]: ...
# C#: Complete f-string literal
fstring[GeneratedExpr]:
    | a=FSTRING_START b=fstring_middle* c=FSTRING_END { JoinedStr(a, b.Cast<GeneratedExprSeq>(), c) }

# String literals
# CPython: string[expr_ty]: s[Token*]=STRING { ConstantFromString(s) }
# C#: String literal
string[GeneratedExpr]: s[GeneratedTokenInfo]=STRING { PyParserHelpers.ConstantFromString(s) }

# CPython: strings[expr_ty] (memo): a[asdl_expr_seq*]=(fstring|string)+ { ConcatenateStrings(a, EXTRA) }
# C#: Concatenated strings (implicit string concatenation)
strings[GeneratedExpr] (memo): a[GeneratedExprSeq]=(fstring|string)+ { PyParserHelpers.ConcatenateStrings(a, EXTRA) }

# Collection literals
# CPython: list[expr_ty]: '[' a=[star_named_expressions] ']' { _PyAST_List(a, Load, EXTRA) }
# C#: List literal [1, 2, 3]
list[GeneratedExpr]:
    | '[' a=[star_named_expressions] ']' { PyAst.List(a, Load, EXTRA) }

# CPython: tuple[expr_ty]: '(' a=[...] ')' { _PyAST_Tuple(a, Load, EXTRA) }
# C#: Tuple literal (1, 2, 3)
tuple[GeneratedExpr]:
    | '(' a=[y=star_named_expression ',' z=[star_named_expressions] { PyParserHelpers.SeqInsertInFront(y, z).Cast<GeneratedExprSeq>() } ] ')' {
        PyAst.Tuple((GeneratedExprSeq?)a, Load, EXTRA) }

# CPython: set[expr_ty]: '{' a=star_named_expressions '}' { _PyAST_Set(a, EXTRA) }
# C#: Set literal {1, 2, 3}
set[GeneratedExpr]: '{' a=star_named_expressions '}' { PyAst.Set(a, EXTRA) }

# Dicts
# -----

# CPython: dict[expr_ty]: '{' a=[double_starred_kvpairs] '}' { _PyAST_Dict(...) }
# C#: Dict literal {key: value, **other}
dict[GeneratedExpr]:
    | '{' a=[double_starred_kvpairs] '}' {
        PyAst.Dict(
            Check<GeneratedExprSeq>(PyParserHelpers.GetKeys(a)),
            Check<GeneratedExprSeq>(PyParserHelpers.GetValues(a)),
            EXTRA) }
    | '{' invalid_double_starred_kvpairs '}'

# CPython: double_starred_kvpairs[asdl_seq*]: a=','.double_starred_kvpair+ [','] { a }
# C#: Dict items including **unpacking
double_starred_kvpairs[GeneratedSeq]: a=','.double_starred_kvpair+ [','] { a }

# CPython: double_starred_kvpair[KeyValuePair*]: ...
# C#: Dict item or **unpacking
double_starred_kvpair[GeneratedKeyValuePair]:
    | '**' a=bitwise_or { PyParserHelpers.KeyValuePair(null, a) }
    | kvpair

# CPython: kvpair[KeyValuePair*]: a=expression ':' b=expression { _PyPegen_key_value_pair(a, b) }
# C#: Dict key:value pair
kvpair[GeneratedKeyValuePair]: a=expression ':' b=expression { PyParserHelpers.KeyValuePair(a, b) }

# Comprehensions & Generators
# ---------------------------
# CPython 3.12 Grammar: Parser/python.gram (lines 664-683)

# CPython: for_if_clauses[asdl_comprehension_seq*]: a[asdl_comprehension_seq*]=for_if_clause+ { a }
# C#: For/if clauses in comprehensions
for_if_clauses[GeneratedComprehensionSeq]:
    | a[GeneratedComprehensionSeq]=for_if_clause+ { a }

# CPython: for_if_clause[comprehension_ty]: ...
# C#: Single for/if clause (supports async for)
for_if_clause[GeneratedComprehension]:
    | ASYNC 'for' a=star_targets 'in' ~ b=disjunction c[GeneratedExprSeq]=('if' z=disjunction { z })* {
        CheckVersion(6, "Async comprehensions are", PyAst.comprehension((GeneratedExpr)a, (GeneratedExpr)b, c, is_async: 1)) }
    | 'for' a=star_targets 'in' ~ b=disjunction c[GeneratedExprSeq]=('if' z=disjunction { z })* {
        PyAst.comprehension((GeneratedExpr)a, (GeneratedExpr)b, c, is_async: 0) }
    | invalid_for_target

# CPython: listcomp[expr_ty]: '[' a=named_expression b=for_if_clauses ']' { _PyAST_ListComp(a, b, EXTRA) }
# C#: List comprehension [x for x in items if condition]
listcomp[GeneratedExpr]:
    | '[' a=named_expression b=for_if_clauses ']' { PyAst.ListComp(a, b, EXTRA) }
    | invalid_comprehension

# CPython: setcomp[expr_ty]: '{' a=named_expression b=for_if_clauses '}' { _PyAST_SetComp(a, b, EXTRA) }
# C#: Set comprehension {x for x in items if condition}
setcomp[GeneratedExpr]:
    | '{' a=named_expression b=for_if_clauses '}' { PyAst.SetComp(a, b, EXTRA) }
    | invalid_comprehension

# CPython: genexp[expr_ty]: '(' a=(...) b=for_if_clauses ')' { _PyAST_GeneratorExp(a, b, EXTRA) }
# C#: Generator expression (x for x in items if condition)
genexp[GeneratedExpr]:
    | '(' a=( assignment_expression | expression !':=') b=for_if_clauses ')' { PyAst.GeneratorExp((GeneratedExpr)a, b, EXTRA) }
    | invalid_comprehension

# CPython: dictcomp[expr_ty]: '{' a=kvpair b=for_if_clauses '}' { _PyAST_DictComp(a.Key, a.Value, b, EXTRA) }
# C#: Dict comprehension {k: v for k, v in items if condition}
dictcomp[GeneratedExpr]:
    | '{' a=kvpair b=for_if_clauses '}' { PyAst.DictComp(a.Key, a.Value, b, EXTRA) }
    | invalid_dict_comprehension

# FUNCTION CALL ARGUMENTS
# =======================
# CPython 3.12 Grammar: Parser/python.gram (lines 685-714)

# CPython: arguments[expr_ty] (memo): a=args [','] &')' { a }
# C#: Function call arguments func(args)
arguments[GeneratedExpr] (memo):
    | a=args [','] &')' { a }
    | invalid_arguments

# CPython: args[expr_ty]: ...
# C#: Positional and keyword arguments
args[GeneratedExpr]:
    | a[GeneratedExprSeq]=','.(starred_expression | ( assignment_expression | expression !':=') !'=')+ b=[',' k=kwargs {k}] {
        PyParserHelpers.CollectCallSeqs(a, (GeneratedSeq?)b, EXTRA) }
    | a=kwargs { PyAst.Call(PyParserHelpers.DummyName(),
                          CheckNullAllowed<GeneratedExprSeq>(PyParserHelpers.SeqExtractStarredExprs(a)),
                          CheckNullAllowed<GeneratedKeywordSeq>(PyParserHelpers.SeqDeleteStarredExprs(a)),
                          EXTRA) }

# CPython: kwargs[asdl_seq*]: ...
# C#: Keyword arguments (name=value or **dict)
kwargs[GeneratedSeq]:
    | a=','.kwarg_or_starred+ ',' b=','.kwarg_or_double_starred+ { PyParserHelpers.JoinSequences(a, b) }
    | ','.kwarg_or_starred+
    | ','.kwarg_or_double_starred+

# CPython: starred_expression[expr_ty]: '*' a=expression { _PyAST_Starred(a, Load, EXTRA) }
# C#: Starred expression *args
starred_expression[GeneratedExpr]:
    | invalid_starred_expression
    | '*' a=expression { PyAst.Starred(a, Load, EXTRA) }
    | '*' { RaiseSyntaxError("Invalid star expression") }

# CPython: kwarg_or_starred[KeywordOrStarred*]: ...
# C#: Keyword argument or *expr (for function calls)
kwarg_or_starred[GeneratedKeywordOrStarred]:
    | invalid_kwarg
    | a=NAME '=' b=expression {
        PyParserHelpers.KeywordOrStarred(Check<GeneratedKeyword>(PyAst.keyword(a.GetNameValue(), b, EXTRA)), is_keyword: 1) }
    | a=starred_expression { PyParserHelpers.KeywordOrStarred(a, is_keyword: 0) }

# CPython: kwarg_or_double_starred[KeywordOrStarred*]: ...
# C#: Keyword argument or **dict (for function calls)
kwarg_or_double_starred[GeneratedKeywordOrStarred]:
    | invalid_kwarg
    | a=NAME '=' b=expression {
        PyParserHelpers.KeywordOrStarred(Check<GeneratedKeyword>(PyAst.keyword(a.GetNameValue(), b, EXTRA)), is_keyword: 1) }
    | '**' a=expression { PyParserHelpers.KeywordOrStarred(Check<GeneratedKeyword>(PyAst.keyword(null, a, EXTRA)), is_keyword: 1) }

# ASSIGNMENT TARGETS
# ==================
# CPython 3.12 Grammar: Parser/python.gram (lines 716-774)

# Generic targets
# ---------------

# NOTE: star_targets may contain *bitwise_or, targets may not.
# CPython: star_targets[expr_ty]: ...
# C#: Assignment targets (can include starred expressions)
star_targets[GeneratedExpr]:
    | a=star_target !',' { a }
    | a=star_target b=(',' c=star_target { c })* [','] {
        PyAst.Tuple((GeneratedExprSeq?)Check<GeneratedExprSeq>(PyParserHelpers.SeqInsertInFront(a, b).Cast<GeneratedExprSeq>()), Store, EXTRA) }

# CPython: star_targets_list_seq[asdl_expr_seq*]: a[asdl_expr_seq*]=','.star_target+ [','] { a }
# C#: Star targets as list sequence [a, b, *rest] = ...
star_targets_list_seq[GeneratedExprSeq]: a[GeneratedExprSeq]=','.star_target+ [','] { a }

# CPython: star_targets_tuple_seq[asdl_expr_seq*]: ...
# C#: Star targets as tuple sequence (a, b, *rest) = ...
star_targets_tuple_seq[GeneratedExprSeq]:
    | a=star_target b=(',' c=star_target { c })+ [','] {  PyParserHelpers.SeqInsertInFront(a, b).Cast<GeneratedExprSeq>() }
    | a=star_target ',' {  PyParserHelpers.SingletonSeq(a).Cast<GeneratedExprSeq>() }

# CPython: star_target[expr_ty] (memo): ...
# C#: Single star target (*a or regular target)
star_target[GeneratedExpr] (memo):
    | '*' a=(!'*' star_target) {
        PyAst.Starred((GeneratedExpr)Check<GeneratedExpr>((GeneratedExpr)PyParserHelpers.SetExprContext((GeneratedExpr)a, Store)), Store, EXTRA) }
    | target_with_star_atom

# CPython: target_with_star_atom[expr_ty] (memo): ...
# C#: Target that may contain star atom
target_with_star_atom[GeneratedExpr] (memo):
    | a=t_primary '.' b=NAME !t_lookahead { PyAst.Attribute(a, b.GetNameValue(), Store, EXTRA) }
    | a=t_primary '[' b=slices ']' !t_lookahead { PyAst.Subscript(a, b, Store, EXTRA) }
    | star_atom

# CPython: star_atom[expr_ty]: ...
# C#: Atomic star target (name, tuple, list)
star_atom[GeneratedExpr]:
    | a=NAME { PyParserHelpers.SetExprContext(NameToken(a), Store) }
    | '(' a=target_with_star_atom ')' { PyParserHelpers.SetExprContext(a, Store) }
    | '(' a=[star_targets_tuple_seq] ')' { PyAst.Tuple(a, Store, EXTRA) }
    | '[' a=[star_targets_list_seq] ']' { PyAst.List(a, Store, EXTRA) }

# CPython: single_target[expr_ty]: ...
# C#: Single assignment target (no star)
single_target[GeneratedExpr]:
    | single_subscript_attribute_target
    | a=NAME { PyParserHelpers.SetExprContext(NameToken(a), Store) }
    | '(' a=single_target ')' { a }

# CPython: single_subscript_attribute_target[expr_ty]: ...
# C#: Subscript or attribute target
single_subscript_attribute_target[GeneratedExpr]:
    | a=t_primary '.' b=NAME !t_lookahead { PyAst.Attribute(a, b.GetNameValue(), Store, EXTRA) }
    | a=t_primary '[' b=slices ']' !t_lookahead { PyAst.Subscript(a, b, Store, EXTRA) }

# CPython: t_primary[expr_ty]: ...
# C#: Primary expression for targets (with lookahead)
t_primary[GeneratedExpr]:
    | a=t_primary '.' b=NAME &t_lookahead { PyAst.Attribute(a, b.GetNameValue(), Load, EXTRA) }
    | a=t_primary '[' b=slices ']' &t_lookahead { PyAst.Subscript(a, b, Load, EXTRA) }
    | a=t_primary b=genexp &t_lookahead {
        PyAst.Call(a, Check<GeneratedExprSeq>(PyParserHelpers.SingletonSeq(b).Cast<GeneratedExprSeq>()), null, EXTRA) }
    | a=t_primary '(' b=[arguments] ')' &t_lookahead {
        PyAst.Call(a,
                 (b != null) ? ((GeneratedCall)b).Args : null!,
                 (b != null) ? ((GeneratedCall)b).Keywords : null!,
                 EXTRA) }
    | a=atom &t_lookahead { a }

# CPython: t_lookahead: '(' | '[' | '.'
# C#: Lookahead for target continuation
t_lookahead: '(' | '[' | '.'

# Targets for del statements
# --------------------------

# CPython: del_targets[asdl_expr_seq*]: a[asdl_expr_seq*]=','.del_target+ [','] { a }
# C#: Deletion targets for del statement
del_targets[GeneratedExprSeq]: a[GeneratedExprSeq]=','.del_target+ [','] { a }

# CPython: del_target[expr_ty] (memo): ...
# C#: Single deletion target
del_target[GeneratedExpr] (memo):
    | a=t_primary '.' b=NAME !t_lookahead { PyAst.Attribute(a, b.GetNameValue(), Del, EXTRA) }
    | a=t_primary '[' b=slices ']' !t_lookahead { PyAst.Subscript(a, b, Del, EXTRA) }
    | del_t_atom

# CPython: del_t_atom[expr_ty]: ...
# C#: Atomic deletion target
del_t_atom[GeneratedExpr]:
    | a=NAME { PyParserHelpers.SetExprContext(NameToken(a), Del) }
    | '(' a=del_target ')' { PyParserHelpers.SetExprContext(a, Del) }
    | '(' a=[del_targets] ')' { PyAst.Tuple(a, Del, EXTRA) }
    | '[' a=[del_targets] ']' { PyAst.List(a, Del, EXTRA) }

# TYPING ELEMENTS
# ---------------
# CPython 3.12 Grammar: Parser/python.gram (lines 776-792)

# type_expressions allow */** but ignore them
# CPython: type_expressions[asdl_expr_seq*]: ...
# C#: Type expressions for func_type (allows *, **)
type_expressions[GeneratedExprSeq]:
    | a=','.expression+ ',' '*' b=expression ',' '**' c=expression {
        PyParserHelpers.SeqAppendToEnd(
            (Check<GeneratedSeq>(PyParserHelpers.SeqAppendToEnd(a, b)).Cast<GeneratedExprSeq>()),
            c).Cast<GeneratedExprSeq>() }
    | a=','.expression+ ',' '*' b=expression { PyParserHelpers.SeqAppendToEnd(a, b).Cast<GeneratedExprSeq>() }
    | a=','.expression+ ',' '**' b=expression { PyParserHelpers.SeqAppendToEnd(a, b).Cast<GeneratedExprSeq>() }
    | '*' a=expression ',' '**' b=expression {
        PyParserHelpers.SeqAppendToEnd(
            (Check<GeneratedSeq>(PyParserHelpers.SingletonSeq(a)).Cast<GeneratedExprSeq>()),
            b).Cast<GeneratedExprSeq>() }
    | '*' a=expression { PyParserHelpers.SingletonSeq(a).Cast<GeneratedExprSeq>() }
    | '**' a=expression { PyParserHelpers.SingletonSeq(a).Cast<GeneratedExprSeq>() }
    | a[GeneratedExprSeq]=','.expression+ {a}

# CPython: func_type_comment[Token*]: ...
# C#: Function type comment (legacy typing)
func_type_comment[GeneratedTokenInfo]:
    | NEWLINE t=TYPE_COMMENT &(NEWLINE INDENT) { t }  # Must be followed by indented block
    | invalid_double_type_comments
    | TYPE_COMMENT

# ========================= END OF THE GRAMMAR ===========================



# ========================= START OF INVALID RULES =======================

# From here on, there are rules for invalid syntax with specialised error messages
invalid_arguments:
    | ((','.(starred_expression | ( assignment_expression | expression !':=') !'=')+ ',' kwargs) | kwargs) a=',' ','.(starred_expression !'=')+ {
        RaiseSyntaxErrorStartingFrom(a, "iterable argument unpacking follows keyword argument unpacking") }
    | a=expression b=for_if_clauses ',' [args | expression for_if_clauses] {
        RaiseSyntaxErrorKnownRange(a, GetLastComprehensionItem(LastItem<GeneratedComprehension>(b)), "Generator expression must be parenthesized") }
    | a=NAME b='=' expression for_if_clauses {
        RaiseSyntaxErrorKnownRange(a, b, "invalid syntax. Maybe you meant '==' or ':=' instead of '='?")}
    | (args ',')? a=NAME b='=' &(',' | ')') {
        RaiseSyntaxErrorKnownRange(a, b, "expected argument value expression")}
    | a=args b=for_if_clauses { NonparenGenexpInCall(a, b) }
    | args ',' a=expression b=for_if_clauses {
        RaiseSyntaxErrorKnownRange(a, GetLastComprehensionItem(LastItem<GeneratedComprehension>(b)), "Generator expression must be parenthesized") }
    | a=args ',' args { ArgumentsParsingError(a) }
invalid_kwarg:
    | a[GeneratedTokenInfo]=('True'|'False'|'None') b='=' {
        RaiseSyntaxErrorKnownRange(a, b, $"cannot assign to %s") }
    | a=NAME b='=' expression for_if_clauses {
        RaiseSyntaxErrorKnownRange(a, b, "invalid syntax. Maybe you meant '==' or ':=' instead of '='?")}
    | !(NAME '=') a=expression b='=' {
        RaiseSyntaxErrorKnownRange(
            a, b, "expression cannot contain assignment, perhaps you meant \"==\"?") }
    | a='**' expression '=' b=expression {
        RaiseSyntaxErrorKnownRange(a, b, "cannot assign to keyword argument unpacking") }

# IMPORTANT: Note that the "_without_invalid" suffix causes the rule to not call invalid rules under it
expression_without_invalid[GeneratedExpr]:
    | a=disjunction 'if' b=disjunction 'else' c=expression { PyAst.IfExp(b, a, c, EXTRA) }
    | disjunction
    | lambdef
invalid_legacy_expression:
    | a=NAME !'(' b=star_expressions {
        CheckLegacyStmt(NameToken(a)) ? RaiseSyntaxErrorKnownRange(NameToken(a), b, $"Missing parentheses in call to '{a.GetNameValue()}'. Did you mean {a.GetNameValue()}(...)?") : null}

invalid_expression:
    # !(NAME STRING) is not matched so we don't show this error with some invalid string prefixes like: kf"dsfsdf"
    # Soft keywords need to also be ignored because they can be parsed as NAME NAME
   | !(NAME STRING | SOFT_KEYWORD) a=disjunction b=expression_without_invalid {
        CheckLegacyStmt(a) ? null : _tokens[_mark-1].Level == 0 ? null :
        RaiseSyntaxErrorKnownRange(a, b, "invalid syntax. Perhaps you forgot a comma?") }
   | a=disjunction 'if' b=disjunction !('else'|':') { RaiseSyntaxErrorKnownRange(a, b, "expected 'else' after 'if' expression") }
   | a='lambda' [lambda_params] b=':' &FSTRING_MIDDLE  {
        RaiseSyntaxErrorKnownRange(a, b, "f-string: lambda expressions are not allowed without parentheses") }

invalid_named_expression(memo):
    | a=expression ':=' expression {
        RaiseSyntaxErrorKnownLocation(
            a, "cannot use assignment expressions with %s", GetExprName(a)) }
    | a=NAME '=' b=bitwise_or !('='|':=') {
        RaiseSyntaxErrorKnownRange(a, b, "invalid syntax. Maybe you meant '==' or ':=' instead of '='?") }
    | !(list|tuple|genexp|'True'|'None'|'False') a=bitwise_or b='=' bitwise_or !('='|':=') {
        RaiseSyntaxErrorKnownLocation(a, "cannot assign to %s here. Maybe you meant '==' instead of '='?",
                                          GetExprName(a)) }

invalid_assignment:
    | a=invalid_ann_assign_target ':' expression {
        RaiseSyntaxErrorKnownLocation(
            a,
            "only single target (not %s) can be annotated",
            GetExprName(a)
        )}
    | a=star_named_expression ',' star_named_expressions* ':' expression {
        RaiseSyntaxErrorKnownLocation(a, "only single target (not tuple) can be annotated") }
    | a=expression ':' expression {
        RaiseSyntaxErrorKnownLocation(a, "illegal target for annotation") }
    | (star_targets '=')* a=star_expressions '=' {
        RaiseSyntaxErrorInvalidTarget("assign to", a) }
    | (star_targets '=')* a=yield_expr '=' { RaiseSyntaxErrorKnownLocation(a, "assignment to yield expression not possible") }
    | a=star_expressions augassign (yield_expr | star_expressions) {
        RaiseSyntaxErrorKnownLocation(
            a,
            "'%s' is an illegal expression for augmented assignment",
            GetExprName(a)
        )}
invalid_ann_assign_target[GeneratedExpr]:
    | list
    | tuple
    | '(' a=invalid_ann_assign_target ')' { a }
invalid_del_stmt:
    | 'del' a=star_expressions {
        RaiseSyntaxErrorInvalidTarget("delete", a) }
invalid_block:
    | NEWLINE !INDENT { RaiseIndentationError("expected an indented block") }
invalid_comprehension:
    | ('[' | '(' | '{') a=starred_expression for_if_clauses {
        RaiseSyntaxErrorKnownLocation(a, "iterable unpacking cannot be used in comprehension") }
    | ('[' | '{') a=star_named_expression ',' b=star_named_expressions for_if_clauses {
        RaiseSyntaxErrorKnownRange(a, LastItem<GeneratedExpr>(b),
        "did you forget parentheses around the comprehension target?") }
    | ('[' | '{') a=star_named_expression b=',' for_if_clauses {
        RaiseSyntaxErrorKnownRange(a, b, "did you forget parentheses around the comprehension target?") }
invalid_dict_comprehension:
    | '{' a='**' bitwise_or for_if_clauses '}' {
        RaiseSyntaxErrorKnownLocation(a, "dict unpacking cannot be used in dict comprehension") }
invalid_parameters:
    | a="/" ',' {
        RaiseSyntaxErrorKnownLocation(a, "at least one argument must precede /") }
    | (slash_no_default | slash_with_default) param_maybe_default* a='/' {
        RaiseSyntaxErrorKnownLocation(a, "/ may appear only once") }
    | slash_no_default? param_no_default* invalid_parameters_helper a=param_no_default {
        RaiseSyntaxErrorKnownLocation(a, "parameter without a default follows parameter with a default") }
    | param_no_default* a='(' param_no_default+ ','? b=')' {
        RaiseSyntaxErrorKnownRange(a, b, "Function parameters cannot be parenthesized") }
    | (slash_no_default | slash_with_default)? param_maybe_default* '*' (',' | param_no_default) param_maybe_default* a='/' {
        RaiseSyntaxErrorKnownLocation(a, "/ must be ahead of *") }
    | param_maybe_default+ '/' a='*' {
        RaiseSyntaxErrorKnownLocation(a, "expected comma between / and *") }
invalid_default:
    | a='=' &(')'|',') { RaiseSyntaxErrorKnownLocation(a, "expected default value expression") }
invalid_star_etc:
    | a='*' (')' | ',' (')' | '**')) { RaiseSyntaxErrorKnownLocation(a, "named arguments must follow bare *") }
    | '*' ',' TYPE_COMMENT { RaiseSyntaxError("bare * has associated type comment") }
    | '*' param a='=' { RaiseSyntaxErrorKnownLocation(a, "var-positional argument cannot have default value") }
    | '*' (param_no_default | ',') param_maybe_default* a='*' (param_no_default | ',') {
        RaiseSyntaxErrorKnownLocation(a, "* argument may appear only once") }
invalid_kwds:
    | '**' param a='=' { RaiseSyntaxErrorKnownLocation(a, "var-keyword argument cannot have default value") }
    | '**' param ',' a=param { RaiseSyntaxErrorKnownLocation(a, "arguments cannot follow var-keyword argument") }
    | '**' param ',' a[GeneratedTokenInfo]=('*'|'**'|'/') { RaiseSyntaxErrorKnownLocation(a, "arguments cannot follow var-keyword argument") }
invalid_parameters_helper[GeneratedArguments]: # This is only there to avoid type errors
    | a=slash_with_default { null }
    | a=param_with_default+ { null }
invalid_lambda_parameters:
    | a="/" ',' {
        RaiseSyntaxErrorKnownLocation(a, "at least one argument must precede /") }
    | (lambda_slash_no_default | lambda_slash_with_default) lambda_param_maybe_default* a='/' {
        RaiseSyntaxErrorKnownLocation(a, "/ may appear only once") }
    | lambda_slash_no_default? lambda_param_no_default* invalid_lambda_parameters_helper a=lambda_param_no_default {
        RaiseSyntaxErrorKnownLocation(a, "parameter without a default follows parameter with a default") }
    | lambda_param_no_default* a='(' ','.lambda_param+ ','? b=')' {
        RaiseSyntaxErrorKnownRange(a, b, "Lambda expression parameters cannot be parenthesized") }
    | (lambda_slash_no_default | lambda_slash_with_default)? lambda_param_maybe_default* '*' (',' | lambda_param_no_default) lambda_param_maybe_default* a='/' {
        RaiseSyntaxErrorKnownLocation(a, "/ must be ahead of *") }
    | lambda_param_maybe_default+ '/' a='*' {
        RaiseSyntaxErrorKnownLocation(a, "expected comma between / and *") }
invalid_lambda_parameters_helper:
    | a=lambda_slash_with_default { SingletonSeq(a) }
    | lambda_param_with_default+
invalid_lambda_star_etc:
    | '*' (':' | ',' (':' | '**')) { RaiseSyntaxError("named arguments must follow bare *") }
    | '*' lambda_param a='=' { RaiseSyntaxErrorKnownLocation(a, "var-positional argument cannot have default value") }
    | '*' (lambda_param_no_default | ',') lambda_param_maybe_default* a='*' (lambda_param_no_default | ',') {
        RaiseSyntaxErrorKnownLocation(a, "* argument may appear only once") }
invalid_lambda_kwds:
    | '**' lambda_param a='=' { RaiseSyntaxErrorKnownLocation(a, "var-keyword argument cannot have default value") }
    | '**' lambda_param ',' a=lambda_param { RaiseSyntaxErrorKnownLocation(a, "arguments cannot follow var-keyword argument") }
    | '**' lambda_param ',' a[GeneratedTokenInfo]=('*'|'**'|'/') { RaiseSyntaxErrorKnownLocation(a, "arguments cannot follow var-keyword argument") }
invalid_double_type_comments:
    | TYPE_COMMENT NEWLINE TYPE_COMMENT NEWLINE INDENT {
        RaiseSyntaxError("Cannot have two type comments on def") }
invalid_with_item:
    | expression 'as' a=expression &(',' | ')' | ':') {
        RaiseSyntaxErrorInvalidTarget("assign to", a) }

invalid_for_target:
    | ASYNC? 'for' a=star_expressions {
        RaiseSyntaxErrorInvalidTarget("use in for loop", a) }

invalid_group:
    | '(' a=starred_expression ')' {
        RaiseSyntaxErrorKnownLocation(a, "cannot use starred expression here") }
    | '(' a='**' expression ')' {
        RaiseSyntaxErrorKnownLocation(a, "cannot use double starred expression here") }
invalid_import:
    | a='import' ','.dotted_name+ 'from' dotted_name {
        RaiseSyntaxErrorStartingFrom(a, "Did you mean to use 'from ... import ...' instead?") }

invalid_import_from_targets:
    | import_from_as_names ',' NEWLINE {
        RaiseSyntaxError("trailing comma not allowed without surrounding parentheses") }

invalid_with_stmt:
    | [ASYNC] 'with' ','.(expression ['as' star_target])+ NEWLINE { RaiseSyntaxError("expected ':'") }
    | [ASYNC] 'with' '(' ','.(expressions ['as' star_target])+ ','? ')' NEWLINE { RaiseSyntaxError("expected ':'") }
invalid_with_stmt_indent:
    | [ASYNC] a='with' ','.(expression ['as' star_target])+ ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after 'with' statement on line %d", a.GetLineNo()) }
    | [ASYNC] a='with' '(' ','.(expressions ['as' star_target])+ ','? ')' ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after 'with' statement on line %d", a.GetLineNo()) }

invalid_try_stmt:
    | a='try' ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after 'try' statement on line %d", a.GetLineNo()) }
    | 'try' ':' block !('except' | 'finally') { RaiseSyntaxError("expected 'except' or 'finally' block") }
    | 'try' ':' block* except_block+ a='except' b='*' expression ['as' NAME] ':' {
        RaiseSyntaxErrorKnownRange(a, b, "cannot have both 'except' and 'except*' on the same 'try'") }
    | 'try' ':' block* except_star_block+ a='except' [expression ['as' NAME]] ':' {
        RaiseSyntaxErrorKnownLocation(a, "cannot have both 'except' and 'except*' on the same 'try'") }
invalid_except_stmt:
    | 'except' '*'? a=expression ',' expressions ['as' NAME ] ':' {
        RaiseSyntaxErrorStartingFrom(a, "multiple exception types must be parenthesized") }
    | a='except' '*'? expression ['as' NAME ] NEWLINE { RaiseSyntaxError("expected ':'") }
    | a='except' NEWLINE { RaiseSyntaxError("expected ':'") }
    | a='except' '*' (NEWLINE | ':') { RaiseSyntaxError("expected one or more exception types") }
invalid_finally_stmt:
    | a='finally' ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after 'finally' statement on line %d", a.GetLineNo()) }
invalid_except_stmt_indent:
    | a='except' expression ['as' NAME ] ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after 'except' statement on line %d", a.GetLineNo()) }
    | a='except' ':' NEWLINE !INDENT { RaiseIndentationError("expected an indented block after 'except' statement on line %d", a.GetLineNo()) }
invalid_except_star_stmt_indent:
    | a='except' '*' expression ['as' NAME ] ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after 'except*' statement on line %d", a.GetLineNo()) }
invalid_match_stmt:
    | "match" subject_expr NEWLINE { CheckVersion(10, "Pattern matching is", RaiseSyntaxError("expected ':'")) }
    | a="match" subject=subject_expr ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after 'match' statement on line %d", a.GetLineNo()) }
invalid_case_block:
    | "case" patterns guard? NEWLINE { RaiseSyntaxError("expected ':'") }
    | a="case" patterns guard? ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after 'case' statement on line %d", a.GetLineNo()) }
invalid_as_pattern:
    | or_pattern 'as' a="_" { RaiseSyntaxErrorKnownLocation(a, "cannot use '_' as a target") }
    | or_pattern 'as' !NAME a=expression { RaiseSyntaxErrorKnownLocation(a, "invalid pattern target") }
invalid_class_pattern:
    | name_or_attr '(' a=invalid_class_argument_pattern  { RaiseSyntaxErrorKnownRange(
        FirstItem<GeneratedPattern>(a),
        LastItem<GeneratedPattern>(a),
        "positional patterns follow keyword patterns") }
invalid_class_argument_pattern[GeneratedPatternSeq]:
    | [positional_patterns ','] keyword_patterns ',' a=positional_patterns { a }
invalid_if_stmt:
    | 'if' named_expression NEWLINE { RaiseSyntaxError("expected ':'") }
    | a='if' named_expression ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after 'if' statement on line %d", a.GetLineNo()) }
invalid_elif_stmt:
    | 'elif' named_expression NEWLINE { RaiseSyntaxError("expected ':'") }
    | a='elif' named_expression ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after 'elif' statement on line %d", a.GetLineNo()) }
invalid_else_stmt:
    | a='else' ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after 'else' statement on line %d", a.GetLineNo()) }
invalid_while_stmt:
    | 'while' named_expression NEWLINE { RaiseSyntaxError("expected ':'") }
    | a='while' named_expression ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after 'while' statement on line %d", a.GetLineNo()) }
invalid_for_stmt:
    | [ASYNC] 'for' star_targets 'in' star_expressions NEWLINE { RaiseSyntaxError("expected ':'") }
    | [ASYNC] a='for' star_targets 'in' star_expressions ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after 'for' statement on line %d", a.GetLineNo()) }
invalid_def_raw:
    | [ASYNC] a='def' NAME [type_params] '(' [params] ')' ['->' expression] ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after function definition on line %d", a.GetLineNo()) }
invalid_class_def_raw:
    | 'class' NAME [type_params] ['(' [arguments] ')'] NEWLINE { RaiseSyntaxError("expected ':'") }
    | a='class' NAME [type_params] ['(' [arguments] ')'] ':' NEWLINE !INDENT {
        RaiseIndentationError("expected an indented block after class definition on line %d", a.GetLineNo()) }

invalid_double_starred_kvpairs:
    | ','.double_starred_kvpair+ ',' invalid_kvpair
    | expression ':' a='*' bitwise_or { RaiseSyntaxErrorStartingFrom(a, "cannot use a starred expression in a dictionary value") }
    | expression a=':' &('}'|',') { RaiseSyntaxErrorKnownLocation(a, "expression expected after dictionary key and ':'") }
invalid_kvpair:
    | a=expression !(':') {
        RaiseErrorKnownLocation(typeof(PySyntaxErrorException), a.GetLineNo(), a.EndColOffset - 1, a.EndLineNo, -1, "':' expected after dictionary key") }
    | expression ':' a='*' bitwise_or { RaiseSyntaxErrorStartingFrom(a, "cannot use a starred expression in a dictionary value") }
    | expression a=':' &('}'|',') {RaiseSyntaxErrorKnownLocation(a, "expression expected after dictionary key and ':'") }
invalid_starred_expression:
    | a='*' expression '=' b=expression { RaiseSyntaxErrorKnownRange(a, b, "cannot assign to iterable argument unpacking") }

invalid_replacement_field:
    | '{' a='=' { RaiseSyntaxErrorKnownLocation(a, "f-string: valid expression required before '='") }
    | '{' a='!' { RaiseSyntaxErrorKnownLocation(a, "f-string: valid expression required before '!'") }
    | '{' a=':' { RaiseSyntaxErrorKnownLocation(a, "f-string: valid expression required before ':'") }
    | '{' a='}' { RaiseSyntaxErrorKnownLocation(a, "f-string: valid expression required before '}'") }
    | '{' !(yield_expr | star_expressions) { RaiseSyntaxErrorOnNextToken("f-string: expecting a valid expression after '{'")}
    | '{' (yield_expr | star_expressions) !('=' | '!' | ':' | '}') {
        PyErr_Occurred() ? null : RaiseSyntaxErrorOnNextToken("f-string: expecting '=', or '!', or ':', or '}'") }
    | '{' (yield_expr | star_expressions) '=' !('!' | ':' | '}') {
        PyErr_Occurred() ? null : RaiseSyntaxErrorOnNextToken("f-string: expecting '!', or ':', or '}'") }
    | '{' (yield_expr | star_expressions) '='? invalid_conversion_character
    | '{' (yield_expr | star_expressions) '='? ['!' NAME] !(':' | '}') {
        PyErr_Occurred() ? null : RaiseSyntaxErrorOnNextToken("f-string: expecting ':' or '}'") }
    | '{' (yield_expr | star_expressions) '='? ['!' NAME] ':' fstring_format_spec* !'}' {
        PyErr_Occurred() ? null : RaiseSyntaxErrorOnNextToken("f-string: expecting '}', or format specs") }
    | '{' (yield_expr | star_expressions) '='? ['!' NAME] !'}' {
        PyErr_Occurred() ? null : RaiseSyntaxErrorOnNextToken("f-string: expecting '}'") }

invalid_conversion_character:
    | '!' &(':' | '}') { RaiseSyntaxErrorOnNextToken("f-string: missing conversion character") }
    | '!' !NAME { RaiseSyntaxErrorOnNextToken("f-string: invalid conversion character") }
