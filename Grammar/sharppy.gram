# PEG grammar for SharpPy (Python 3.12 compatible)
# Based on CPython 3.12 grammar with C# AST generation actions

# ========================= GRAMMAR NOTATION =========================
#
# General grammatical elements and rules:
# * Strings with double quotes (") denote SOFT KEYWORDS
# * Strings with single quotes (') denote KEYWORDS
# * Upper case names (NAME) denote tokens from PyLexer
# * Rule names starting with "invalid_" are used for specialized syntax errors
#
# Grammar Syntax (see PEP 617):
# rule_name: expression
# rule_name[return_type]: expression
# e1 e2      - Match e1, then match e2
# e1 | e2    - Match e1 or e2 (ordered choice)
# ( e )      - Group expression
# [ e ] or e? - Optional match
# e*         - Match zero or more occurrences
# e+         - Match one or more occurrences
# s.e+       - Match one or more e separated by s
# &e         - Positive lookahead
# !e         - Negative lookahead
# ~          - Commit to current alternative

# ========================= STARTING RULES =========================

file[List<Statement>]: a=statements? ENDMARKER { a ?? new List<Statement>() }

interactive[List<Statement>]: a=statement_newline { a }

eval[Expression]: a=expressions NEWLINE* ENDMARKER { a }

# ========================= STATEMENTS =========================

statements[List<Statement>]: a=statement+ { a.SelectMany(s => s).ToList() }

statement[List<Statement>]:
    | a=compound_stmt { new List<Statement> { a } }
    | a=simple_stmts { a }

statement_newline[List<Statement>]:
    | a=compound_stmt NEWLINE { new List<Statement> { a } }
    | simple_stmts
    | NEWLINE { new List<Statement> { new PassStatement() } }

simple_stmts[List<Statement>]:
    | a=simple_stmt !';' NEWLINE { new List<Statement> { a } }
    | a=simple_stmt_list [';'] NEWLINE { a }

simple_stmt_list[List<Statement>]: a=';'.simple_stmt+ { a }

# NOTE: assignment MUST precede expression per CPython grammar
simple_stmt[Statement]:
    | assignment
    | type_alias
    | e=star_expressions { new ExpressionStatement(e) }
    | return_stmt
    | import_stmt
    | raise_stmt
    | 'pass' { new PassStatement() }
    | del_stmt
    | yield_stmt
    | assert_stmt
    | 'break' { new BreakStatement() }
    | 'continue' { new ContinueStatement() }
    | global_stmt
    | nonlocal_stmt

compound_stmt[Statement]:
    | function_def
    | if_stmt
    | class_def
    | with_stmt
    | for_stmt
    | try_stmt
    | while_stmt
    | match_stmt

# ========================= SIMPLE STATEMENTS =========================

assignment[Statement]:
    | a=NAME ':' b=expression c=['=' d=annotated_rhs { d }] {
        new AnnAssignStatement(new NameExpression(a.Lexeme), b, c, true) }
    | a=single_target ':' b=expression c=['=' d=annotated_rhs { d }] {
        new AnnAssignStatement(a, b, c, false) }
    | a=star_targets_list '=' b=annotated_rhs {
        new AssignStatement(a, b) }
    | a=single_target b=augassign c=annotated_rhs {
        new AugAssignStatement(a, b, c) }

star_targets_list[List<Expression>]: a=('=' star_targets)+ { a.Select(x => x.Item2).ToList() }

annotated_rhs[Expression]: yield_expr | star_expressions

augassign[string]:
    | '+=' { "Add" }
    | '-=' { "Sub" }
    | '*=' { "Mult" }
    | '@=' { "MatMult" }
    | '/=' { "Div" }
    | '%=' { "Mod" }
    | '&=' { "BitAnd" }
    | '|=' { "BitOr" }
    | '^=' { "BitXor" }
    | '<<=' { "LShift" }
    | '>>=' { "RShift" }
    | '**=' { "Pow" }
    | '//=' { "FloorDiv" }

return_stmt[Statement]:
    | 'return' a=star_expressions? { new ReturnStatement(a) }

raise_stmt[Statement]:
    | 'raise' a=expression b=['from' z=expression { z }]? { new RaiseStatement(a, b) }
    | 'raise' { new RaiseStatement(null, null) }

global_stmt[Statement]:
    'global' a=name_list { new GlobalStatement(a.Select(n => n.Lexeme).ToList()) }

nonlocal_stmt[Statement]:
    'nonlocal' a=name_list { new NonlocalStatement(a.Select(n => n.Lexeme).ToList()) }

name_list[List<PyToken>]: ','.NAME+

del_stmt[Statement]:
    'del' a=del_targets { new DeleteStatement(a) }

yield_stmt[Statement]: y=yield_expr { new ExpressionStatement(y) }

assert_stmt[Statement]:
    'assert' a=expression b=[',' z=expression { z }]? { new AssertStatement(a, b) }

import_stmt[Statement]:
    | import_name
    | import_from

import_name[Statement]:
    'import' a=dotted_as_names { new ImportStatement(a) }

import_from[Statement]:
    'from' a=module_name 'import' b=import_from_targets {
        new ImportFromStatement(a, b) }

dotted_as_names[List<string>]: ','.dotted_as_name+

dotted_as_name[string]:
    a=dotted_name b=['as' NAME { $2.Lexeme }]? { b ?? a }

dotted_name[string]:
    a=NAME b=('.' NAME)* { a.Lexeme + string.Join("", b.Select(x => "." + x.Item2.Lexeme)) }

module_name[string]: dotted_name

import_from_targets[List<string>]:
    | '(' a=import_from_as_names [','] ')' { a }
    | import_from_as_names
    | '*' { new List<string> { "*" } }

import_from_as_names[List<string>]: ','.import_from_as_name+

import_from_as_name[string]:
    a=NAME b=['as' z=NAME { z.Lexeme }]? { b ?? a.Lexeme }

# ========================= COMPOUND STATEMENTS =========================

function_def[Statement]:
    | decorators function_def_raw { $2.Decorators = $1; $2 }
    | function_def_raw

function_def_raw[FunctionStatement]:
    | 'def' a=NAME '(' b=params? ')' c=['->' z=expression { z }] ':' d=func_type_comment? e=block {
        new FunctionStatement(a.Lexeme, b ?? new List<string>(), e, c, d, false) }
    | ASYNC 'def' a=NAME '(' b=params? ')' c=['->' z=expression { z }] ':' d=func_type_comment? e=block {
        new FunctionStatement(a.Lexeme, b ?? new List<string>(), e, c, d, true) }

decorators[List<DecoratorExpression>]: a=decorator+ { a }

decorator[DecoratorExpression]:
    '@' a=dotted_name b=['(' c=arguments? ')' { c }]? NEWLINE {
        new DecoratorExpression(a, b) }

params[List<string>]: a=parameters { a }

parameters[List<string>]:
    | a=slash_no_default b=param_no_default* c=param_with_default* d=star_etc? {
        new List<string>().Concat(a).Concat(b).Concat(c).Concat(d ?? new List<string>()).ToList() }
    | a=slash_with_default b=param_with_default* c=star_etc? {
        new List<string>().Concat(a).Concat(b).Concat(c ?? new List<string>()).ToList() }
    | a=param_no_default+ b=param_with_default* c=star_etc? {
        new List<string>().Concat(a).Concat(b).Concat(c ?? new List<string>()).ToList() }
    | a=param_with_default+ b=star_etc? {
        new List<string>().Concat(a).Concat(b ?? new List<string>()).ToList() }
    | star_etc

# Basic parameter parsing - simplified for initial implementation
slash_no_default[List<string>]: a=param_no_default+ '/' { a }
slash_with_default[List<string>]: a=param_no_default* b=param_with_default+ '/' { a.Concat(b).ToList() }
param_no_default[string]: a=param { a }
param_with_default[string]: a=param '=' b=default_value { a }
param[string]: a=NAME b=[':' expression]? { a.Lexeme }
default_value[Expression]: expression
star_etc[List<string>]: a=('*' param? | '**' param)+ { a.Select(x => x.ToString()).ToList() }

func_type_comment[string]: TYPE_COMMENT

if_stmt[Statement]:
    | 'if' a=named_expression ':' b=block c=elif_stmt* d=else_block? {
        new IfStatement(a, b, c.ToList(), d) }

elif_stmt[ElifClause]:
    'elif' a=named_expression ':' b=block { new ElifClause(a, b) }

else_block[List<Statement>]: 'else' ':' block

while_stmt[Statement]:
    'while' a=named_expression ':' b=block c=else_block? {
        new WhileStatement(a, b, c) }

for_stmt[Statement]:
    | 'for' a=star_targets 'in' b=star_expressions ':' c=TYPE_COMMENT? d=block e=else_block? {
        new ForStatement(a, b, d, e, false) }
    | ASYNC 'for' a=star_targets 'in' b=star_expressions ':' c=TYPE_COMMENT? d=block e=else_block? {
        new ForStatement(a, b, d, e, true) }

with_stmt[Statement]:
    | 'with' '(' a=','.with_item+ [','] ')' ':' b=block {
        new WithStatement(a, b, false) }
    | 'with' a=','.with_item+ ':' b=block {
        new WithStatement(a, b, false) }
    | ASYNC 'with' '(' a=','.with_item+ [','] ')' ':' b=block {
        new WithStatement(a, b, true) }
    | ASYNC 'with' a=','.with_item+ ':' b=block {
        new WithStatement(a, b, true) }

with_item[WithItem]:
    a=expression b=['as' z=star_target { z }]? { new WithItem(a, b) }

try_stmt[Statement]:
    | 'try' ':' a=block b=finally_block { new TryStatement(a, new List<ExceptClause>(), null, b) }
    | 'try' ':' a=block b=except_block+ c=else_block? d=finally_block? {
        new TryStatement(a, b, c, d) }
    | 'try' ':' a=block b=except_star_block+ c=else_block? d=finally_block? {
        new TryStatement(a, b, c, d) }

except_block[ExceptClause]:
    'except' a=expression? b=['as' NAME { $2.Lexeme }]? ':' c=block {
        new ExceptClause(a, b, c, false) }

except_star_block[ExceptClause]:
    'except' '*' a=expression b=['as' NAME { $2.Lexeme }]? ':' c=block {
        new ExceptClause(a, b, c, true) }

finally_block[List<Statement>]: 'finally' ':' block

match_stmt[Statement]:
    "match" a=subject_expr ':' NEWLINE INDENT b=case_block+ DEDENT {
        new MatchStatement(a, b) }

subject_expr[Expression]: star_named_expression

case_block[MatchCase]:
    "case" a=patterns b=guard? ':' c=block { new MatchCase(a, b, c) }

guard[Expression]: 'if' named_expression

patterns[List<Pattern>]: a=open_sequence_pattern { a } | pattern

pattern[Pattern]: as_pattern | or_pattern

as_pattern[Pattern]: a=or_pattern 'as' b=pattern_capture_target { new AsPattern(a, b) }

or_pattern[Pattern]: '|'.closed_pattern+

closed_pattern[Pattern]:
    | literal_pattern
    | capture_pattern
    | wildcard_pattern
    | value_pattern
    | group_pattern
    | sequence_pattern
    | mapping_pattern
    | class_pattern

literal_pattern[Pattern]:
    | signed_number { new LiteralPattern($1) }
    | complex_number { new LiteralPattern($1) }
    | strings { new LiteralPattern($1) }
    | 'None' { new LiteralPattern(null) }
    | 'True' { new LiteralPattern(true) }
    | 'False' { new LiteralPattern(false) }

signed_number[object]:
    | NUMBER { ParseNumber($1.Lexeme) }
    | '-' NUMBER { ParseNumber("-" + $2.Lexeme) }

complex_number[object]: NUMBER { ParseComplexNumber($1.Lexeme) }

strings[string]: STRING+

capture_pattern[Pattern]: pattern_capture_target

pattern_capture_target[string]: !"_" NAME { $2.Lexeme }

wildcard_pattern[Pattern]: "_" { new WildcardPattern() }

value_pattern[Pattern]: attr { new ValuePattern($1) }

attr[Expression]:
    a=NAME b=('.' NAME)+ { CreateAttributeExpression(a.Lexeme, b.Select(x => x.Item2.Lexeme).ToList()) }

name_or_attr[Expression]:
    | attr
    | NAME { new NameExpression($1.Lexeme) }

group_pattern[Pattern]: '(' pattern ')'

sequence_pattern[Pattern]:
    | '[' a=maybe_sequence_pattern? ']' { new SequencePattern(a ?? new List<Pattern>(), true) }
    | '(' a=open_sequence_pattern? ')' { new SequencePattern(a ?? new List<Pattern>(), false) }

open_sequence_pattern[List<Pattern>]: a=maybe_star_pattern ',' b=maybe_sequence_pattern? {
    new List<Pattern> { a }.Concat(b ?? new List<Pattern>()).ToList() }

maybe_sequence_pattern[List<Pattern>]: ','.maybe_star_pattern+

maybe_star_pattern[Pattern]:
    | star_pattern
    | pattern

star_pattern[Pattern]: '*' a=pattern_capture_target? { new StarPattern(a) }

mapping_pattern[Pattern]:
    '{' a=items_pattern? '}' { new MappingPattern(a ?? new Dictionary<Pattern, Pattern>()) }

items_pattern[Dictionary<Pattern, Pattern>]:
    ','.key_value_pattern+ { $1.ToDictionary(kvp => kvp.Key, kvp => kvp.Value) }

key_value_pattern[KeyValuePair<Pattern, Pattern>]:
    | a=(literal_pattern | attr) ':' b=pattern { new KeyValuePair<Pattern, Pattern>(a, b) }
    | double_star_pattern

double_star_pattern[KeyValuePair<Pattern, Pattern>]:
    '**' a=pattern_capture_target { new KeyValuePair<Pattern, Pattern>(new StarPattern(a), null) }

class_pattern[Pattern]:
    a=name_or_attr '(' b=positional_patterns? c=keyword_patterns? ')' {
        new ClassPattern(a, b ?? new List<Pattern>(), c ?? new Dictionary<string, Pattern>()) }

positional_patterns[List<Pattern>]: ','.pattern+

keyword_patterns[Dictionary<string, Pattern>]:
    ','.keyword_pattern+ { $1.ToDictionary(kv => kv.Key, kv => kv.Value) }

keyword_pattern[KeyValuePair<string, Pattern>]:
    a=NAME '=' b=pattern { new KeyValuePair<string, Pattern>(a.Lexeme, b) }

class_def[Statement]:
    | decorators class_def_raw { $2.Decorators = $1; $2 }
    | class_def_raw

class_def_raw[ClassStatement]:
    'class' a=NAME b=['(' c=arguments? ')' { c }]? ':' d=block {
        new ClassStatement(a.Lexeme, b, d) }

type_alias[Statement]:
    "type" a=NAME b=type_params? '=' c=expression {
        new TypeAliasStatement(a.Lexeme, b, c) }

type_params[List<string>]: '[' a=type_param_list ']' { a }

type_param_list[List<string>]: ','.type_param+

type_param[string]:
    | a=NAME b=type_param_bound? { a.Lexeme + (b ?? "") }
    | '*' a=NAME { "*" + a.Lexeme }
    | '**' a=NAME { "**" + a.Lexeme }

type_param_bound[string]: ':' expression { ": " + $2.ToString() }

# ========================= EXPRESSIONS =========================

expressions[Expression]:
    | a=expression b=(',' c=expression { c })+ [','] {
        new TupleExpression(new List<Expression> { a }.Concat(b).ToList()) }
    | expression

expression[Expression]:
    | a=disjunction 'if' b=disjunction 'else' c=expression { new ConditionalExpression(b, a, c) }
    | disjunction
    | lambdef

lambdef[Expression]:
    'lambda' a=lambda_params? ':' b=expression { new LambdaExpression(a ?? new List<string>(), b) }

lambda_params[List<string>]: lambda_parameters

lambda_parameters[List<string>]:
    a=lambda_slash_no_default b=lambda_param_no_default* c=lambda_param_with_default* d=lambda_star_etc? {
        new List<string>().Concat(a).Concat(b).Concat(c).Concat(d ?? new List<string>()).ToList() }
    | a=lambda_slash_with_default b=lambda_param_with_default* c=lambda_star_etc? {
        new List<string>().Concat(a).Concat(b).Concat(c ?? new List<string>()).ToList() }
    | a=lambda_param_no_default+ b=lambda_param_with_default* c=lambda_star_etc? {
        new List<string>().Concat(a).Concat(b).Concat(c ?? new List<string>()).ToList() }
    | a=lambda_param_with_default+ b=lambda_star_etc? {
        new List<string>().Concat(a).Concat(b ?? new List<string>()).ToList() }
    | lambda_star_etc

# Simplified lambda parameter parsing
lambda_slash_no_default[List<string>]: a=lambda_param_no_default+ '/' { a }
lambda_slash_with_default[List<string>]: a=lambda_param_no_default* b=lambda_param_with_default+ '/' { a.Concat(b).ToList() }
lambda_param_no_default[string]: lambda_param
lambda_param_with_default[string]: lambda_param '=' default_value { $1 }
lambda_param[string]: NAME { $1.Lexeme }
lambda_star_etc[List<string>]: ('*' lambda_param? | '**' lambda_param)+ { $1.Select(x => x.ToString()).ToList() }

disjunction[Expression]:
    | a=conjunction b=('or' c=conjunction { c })+ { CreateBoolOp("Or", new List<Expression> { a }.Concat(b).ToList()) }
    | conjunction

conjunction[Expression]:
    | a=inversion b=('and' c=inversion { c })+ { CreateBoolOp("And", new List<Expression> { a }.Concat(b).ToList()) }
    | inversion

inversion[Expression]:
    | 'not' a=inversion { new UnaryOpExpression("Not", a) }
    | comparison

comparison[Expression]:
    | a=bitwise_or b=compare_op_bitwise_or_pair+ { CreateCompare(a, b) }
    | bitwise_or

compare_op_bitwise_or_pair[Tuple<string, Expression>]:
    | a=eq_bitwise_or { a }
    | a=noteq_bitwise_or { a }
    | a=lte_bitwise_or { a }
    | a=lt_bitwise_or { a }
    | a=gte_bitwise_or { a }
    | a=gt_bitwise_or { a }
    | a=notin_bitwise_or { a }
    | a=in_bitwise_or { a }
    | a=isnot_bitwise_or { a }
    | a=is_bitwise_or { a }

eq_bitwise_or[Tuple<string, Expression>]: '==' a=bitwise_or { Tuple.Create("Eq", a) }
noteq_bitwise_or[Tuple<string, Expression>]: '!=' a=bitwise_or { Tuple.Create("NotEq", a) }
lte_bitwise_or[Tuple<string, Expression>]: '<=' a=bitwise_or { Tuple.Create("LtE", a) }
lt_bitwise_or[Tuple<string, Expression>]: '<' a=bitwise_or { Tuple.Create("Lt", a) }
gte_bitwise_or[Tuple<string, Expression>]: '>=' a=bitwise_or { Tuple.Create("GtE", a) }
gt_bitwise_or[Tuple<string, Expression>]: '>' a=bitwise_or { Tuple.Create("Gt", a) }
notin_bitwise_or[Tuple<string, Expression>]: 'not' 'in' a=bitwise_or { Tuple.Create("NotIn", a) }
in_bitwise_or[Tuple<string, Expression>]: 'in' a=bitwise_or { Tuple.Create("In", a) }
isnot_bitwise_or[Tuple<string, Expression>]: 'is' 'not' a=bitwise_or { Tuple.Create("IsNot", a) }
is_bitwise_or[Tuple<string, Expression>]: 'is' a=bitwise_or { Tuple.Create("Is", a) }

bitwise_or[Expression]:
    | a=bitwise_xor b=('|' c=bitwise_xor { c })+ { CreateBinOp("BitOr", new List<Expression> { a }.Concat(b).ToList()) }
    | bitwise_xor

bitwise_xor[Expression]:
    | a=bitwise_and b=('^' c=bitwise_and { c })+ { CreateBinOp("BitXor", new List<Expression> { a }.Concat(b).ToList()) }
    | bitwise_and

bitwise_and[Expression]:
    | a=shift_expr b=('&' c=shift_expr { c })+ { CreateBinOp("BitAnd", new List<Expression> { a }.Concat(b).ToList()) }
    | shift_expr

shift_expr[Expression]:
    | a=sum b=(('<<'|'>>') c=sum { Tuple.Create($2, c) })+ { CreateBinOpChain(a, b) }
    | sum

sum[Expression]:
    | a=term b=(('+'|'-') c=term { Tuple.Create($2, c) })+ { CreateBinOpChain(a, b) }
    | term

term[Expression]:
    | a=factor b=(('*'|'@'|'/'|'%'|'//') c=factor { Tuple.Create($2, c) })+ { CreateBinOpChain(a, b) }
    | factor

factor[Expression]:
    | '+' a=factor { new UnaryOpExpression("UAdd", a) }
    | '-' a=factor { new UnaryOpExpression("USub", a) }
    | '~' a=factor { new UnaryOpExpression("Invert", a) }
    | power

power[Expression]:
    | a=await_primary '**' b=factor { new BinaryOpExpression(a, "Pow", b) }
    | await_primary

await_primary[Expression]:
    | AWAIT a=primary { new AwaitExpression(a) }
    | primary

primary[Expression]:
    | a=primary '.' b=NAME { new AttributeExpression(a, b.Lexeme) }
    | a=primary b=genexp { new CallExpression(a, new List<Expression> { b }, new List<KeywordExpression>()) }
    | a=primary '(' b=arguments? ')' { new CallExpression(a, b?.Arguments ?? new List<Expression>(), b?.Keywords ?? new List<KeywordExpression>()) }
    | a=primary '[' b=slices ']' { new SubscriptExpression(a, b) }
    | atom

atom[Expression]:
    | NAME { new NameExpression($1.Lexeme) }
    | 'True' { new LiteralExpression(true) }
    | 'False' { new LiteralExpression(false) }
    | 'None' { new LiteralExpression(null) }
    | '__peg_parser__' { new LiteralExpression("PEG") }
    | NUMBER { new LiteralExpression(ParseNumber($1.Lexeme)) }
    | strings { new LiteralExpression($1) }
    | tuple
    | group
    | list
    | dict
    | set
    | genexp
    | listcomp
    | dictcomp
    | setcomp

group[Expression]: '(' a=(yield_expr | named_expression) ')' { a }

lambdef_nocond[Expression]:
    'lambda' a=lambda_params? ':' b=expression_nocond { new LambdaExpression(a ?? new List<string>(), b) }

expression_nocond[Expression]:
    | disjunction
    | lambdef_nocond

named_expression[Expression]:
    | a=NAME ':=' ~ b=expression { new NamedExpression(a.Lexeme, b) }
    | expression

star_expressions[Expression]:
    | a=star_expression b=(',' c=star_expression { c })+ [','] {
        new TupleExpression(new List<Expression> { a }.Concat(b).ToList()) }
    | a=star_expression ',' { new TupleExpression(new List<Expression> { a }) }
    | star_expression

star_expression[Expression]:
    | '*' a=bitwise_or { new StarredExpression(a) }
    | expression

star_named_expressions[Expression]:
    | a=star_named_expression b=(',' c=star_named_expression { c })+ [','] {
        new TupleExpression(new List<Expression> { a }.Concat(b).ToList()) }
    | a=star_named_expression ',' { new TupleExpression(new List<Expression> { a }) }
    | star_named_expression

star_named_expression[Expression]:
    | '*' a=bitwise_or { new StarredExpression(a) }
    | named_expression

assignment_expression[Expression]:
    | a=NAME ':=' ~ b=expression { new NamedExpression(a.Lexeme, b) }

star_targets[Expression]:
    | a=star_target b=(',' c=star_target { c })* [','] {
        b.Any() ? new TupleExpression(new List<Expression> { a }.Concat(b).ToList()) : a }

star_target[Expression]:
    | '*' a=(!'*' star_target) { new StarredExpression(a) }
    | target_with_star_atom

target_with_star_atom[Expression]:
    | a=t_primary '.' b=NAME { new AttributeExpression(a, b.Lexeme) }
    | a=t_primary '[' b=slices ']' { new SubscriptExpression(a, b) }
    | star_atom

star_atom[Expression]:
    | NAME { new NameExpression($1.Lexeme) }
    | '(' a=target_with_star_atom ')' { a }
    | '(' a=star_targets_seq? ')' { new TupleExpression(a ?? new List<Expression>()) }
    | '[' a=star_targets_seq? ']' { new ListExpression(a ?? new List<Expression>()) }

star_targets_seq[List<Expression>]: ','.star_target+

single_target[Expression]:
    | single_subscript_attribute_target
    | NAME { new NameExpression($1.Lexeme) }
    | '(' a=single_target ')' { a }

single_subscript_attribute_target[Expression]:
    | a=t_primary '.' b=NAME { new AttributeExpression(a, b.Lexeme) }
    | a=t_primary '[' b=slices ']' { new SubscriptExpression(a, b) }

t_primary[Expression]:
    | a=t_primary '.' b=NAME { new AttributeExpression(a, b.Lexeme) }
    | a=t_primary '[' b=slices ']' { new SubscriptExpression(a, b) }
    | a=t_primary b=genexp { new CallExpression(a, new List<Expression> { b }, new List<KeywordExpression>()) }
    | a=t_primary '(' b=arguments? ')' { new CallExpression(a, b?.Arguments ?? new List<Expression>(), b?.Keywords ?? new List<KeywordExpression>()) }
    | atom

del_targets[List<Expression>]: ','.del_target+

del_target[Expression]:
    | a=t_primary '.' b=NAME { new AttributeExpression(a, b.Lexeme) }
    | a=t_primary '[' b=slices ']' { new SubscriptExpression(a, b) }
    | del_t_atom

del_t_atom[Expression]:
    | NAME { new NameExpression($1.Lexeme) }
    | '(' a=del_target ')' { a }
    | '(' a=del_targets? ')' { new TupleExpression(a ?? new List<Expression>()) }
    | '[' a=del_targets? ']' { new ListExpression(a ?? new List<Expression>()) }

# ========================= COLLECTION LITERALS =========================

tuple[Expression]:
    | '(' a=[yield_expr | star_named_expressions] ')' { new TupleExpression(GetExpressionList(a)) }

list[Expression]:
    | '[' a=star_named_expressions? ']' { new ListExpression(GetExpressionList(a)) }

set[Expression]:
    | '{' a=star_named_expressions '}' { new SetExpression(GetExpressionList(a)) }

dict[Expression]:
    | '{' a=double_starred_kvpairs? '}' { new DictExpression(a ?? new List<KeyValuePair<Expression, Expression>>()) }
    | '{' a=dict_comp '}' { a }

double_starred_kvpairs[List<KeyValuePair<Expression, Expression>>]: ','.double_starred_kvpair+

double_starred_kvpair[KeyValuePair<Expression, Expression>]:
    | '**' a=bitwise_or { new KeyValuePair<Expression, Expression>(new StarredExpression(null), a) }
    | a=kvpair { a }

kvpair[KeyValuePair<Expression, Expression>]: a=expression ':' b=expression { new KeyValuePair<Expression, Expression>(a, b) }

# ========================= COMPREHENSIONS =========================

for_if_clauses[List<ComprehensionClause>]: a=for_if_clause+ { a }

for_if_clause[ComprehensionClause]:
    ASYNC? 'for' a=star_targets 'in' ~ b=disjunction c=('if' z=disjunction { z })* {
        new ComprehensionClause(a, b, c.ToList(), $1.HasValue) }

listcomp[Expression]:
    '[' a=named_expression ~ b=for_if_clauses ']' { new ListCompExpression(a, b) }

setcomp[Expression]:
    '{' a=named_expression ~ b=for_if_clauses '}' { new SetCompExpression(a, b) }

genexp[Expression]:
    '(' a=assignment_expression ~ b=for_if_clauses ')' { new GeneratorExpression(a, b) }

dictcomp[Expression]:
    '{' a=kvpair ~ b=for_if_clauses '}' { new DictCompExpression(a.Key, a.Value, b) }

# ========================= FUNCTION CALLS =========================

arguments[ArgumentList]:
    a=args [','] { a }

args[ArgumentList]:
    | a=starred_expression b=(',' c=starred_expression { c })* c=(',' d=kwargs { d })? {
        new ArgumentList(new List<Expression> { a }.Concat(b).ToList(), c ?? new List<KeywordExpression>()) }
    | kwargs

starred_expression[Expression]:
    | '*' a=expression { new StarredExpression(a) }
    | assignment_expression

kwargs[List<KeywordExpression>]: ','.kwarg_or_starred+

kwarg_or_starred[KeywordExpression]:
    | a=NAME '=' b=expression { new KeywordExpression(a.Lexeme, b) }
    | '**' a=expression { new KeywordExpression(null, a) }

kwarg_or_double_starred[KeywordExpression]:
    | a=NAME '=' b=expression { new KeywordExpression(a.Lexeme, b) }
    | '**' a=expression { new KeywordExpression(null, a) }

# ========================= SLICING =========================

slices[Expression]:
    | a=slice b=(',' c=slice { c })+ [','] {
        new TupleExpression(new List<Expression> { a }.Concat(b).ToList()) }
    | slice

slice[Expression]:
    | a=expression? ':' b=expression? c=[':' z=expression? { z }] { new SliceExpression(a, b, c) }
    | named_expression

# ========================= YIELD EXPRESSIONS =========================

yield_expr[Expression]:
    | 'yield' 'from' a=expression { new YieldFromExpression(a) }
    | 'yield' a=star_expressions? { new YieldExpression(a) }

# ========================= BLOCKS =========================

block[List<Statement>]: NEWLINE INDENT a=statements DEDENT { a }

# ========================= TOKEN DEFINITIONS =========================
# These will be handled by PyLexer - just documentation here

# Tokens from PyLexer:
# NAME - Identifiers
# NUMBER - Numeric literals
# STRING - String literals
# NEWLINE - End of line
# INDENT/DEDENT - Indentation changes
# ENDMARKER - End of input
# OP - Operators and punctuation
# COMMENT - Comments (ignored in parsing)
# NL - Newlines inside brackets
# ERRORTOKEN - Lexical errors
# ENCODING - File encoding
# TYPE_COMMENT - Type comments
# ASYNC - 'async' keyword
# AWAIT - 'await' keyword